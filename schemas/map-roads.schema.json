{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dailyfuel/map-roads/1",
  "title": "NTAD National Highway Freight Network lines in the 50 states plus DC, merged by route sign and simplified",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source", "source_url", "licence", "attribution", "licence_note", "version", "compiled",
    "data_edited", "fetched", "query_url", "codes", "signs", "fields", "precision", "tolerance_deg", "encoding",
    "counts", "dropped_outside_us", "lines"
  ],
  "properties": {
    "schema": { "const": "dailyfuel/map-roads/1" },
    "source": { "type": "string", "pattern": "National Highway Freight Network" },
    "source_url": { "type": "string", "format": "uri" },
    "licence": { "type": "string", "pattern": "[Pp]ublic domain" },
    "attribution": { "type": "string", "pattern": "NTAD National Highway Freight Network, U\\.S\\. DOT BTS, public domain" },
    "licence_note": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "null"], "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$" },
    "compiled": { "type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "data_edited": { "type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "fetched": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "query_url": { "type": "string", "format": "uri" },
    "codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2"],
      "properties": {
        "1": { "type": "string", "minLength": 1 },
        "2": { "type": "string", "minLength": 1 }
      }
    },
    "signs": { "type": "string", "minLength": 1 },
    "fields": { "const": ["sign", "code", "pts"] },
    "precision": { "type": "integer", "minimum": 1, "maximum": 6 },
    "tolerance_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "encoding": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "paths", "dropped_outside_us", "lines", "signs", "points_before_simplify", "points"],
      "properties": {
        "features": { "type": "integer", "minimum": 1 },
        "paths": { "type": "integer", "minimum": 1 },
        "dropped_outside_us": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 1 },
        "signs": { "type": "integer", "minimum": 1 },
        "points_before_simplify": { "type": "integer", "minimum": 2 },
        "points": { "type": "integer", "minimum": 2 }
      }
    },
    "dropped_outside_us": {
      "description": "Paths dropped by the point in polygon test, by the source's ST_NAME",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
          { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]{1,5}$" },
          { "enum": [1, 2] },
          { "type": "array", "minItems": 4, "items": { "type": "integer" } }
        ]
      }
    }
  }
}
