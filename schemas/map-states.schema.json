{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dailyfuel/map-states/1",
  "title": "The 50 states plus DC as simplified GeoJSON in true positions, from the Census 1:20,000,000 boundary file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type", "schema", "source", "source_url", "licence", "attribution", "fetched", "tolerance_deg", "precision",
    "min_area_deg2", "note", "counts", "features"
  ],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "schema": { "const": "dailyfuel/map-states/1" },
    "source": { "type": "string", "pattern": "Census" },
    "source_url": { "type": "string", "format": "uri" },
    "licence": { "type": "string", "pattern": "[Pp]ublic domain" },
    "attribution": { "type": "string", "minLength": 1 },
    "fetched": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tolerance_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "precision": { "type": "integer", "minimum": 1, "maximum": 6 },
    "min_area_deg2": { "type": "number", "minimum": 0 },
    "note": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "polygons", "points", "dropped_islands"],
      "properties": {
        "features": { "const": 51 },
        "polygons": { "type": "integer", "minimum": 51 },
        "points": { "type": "integer", "minimum": 1 },
        "dropped_islands": { "type": "integer", "minimum": 0 }
      }
    },
    "features": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "properties", "geometry"],
        "properties": {
          "type": { "const": "Feature" },
          "id": { "type": "string", "pattern": "^\\d{2}$" },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "MultiPolygon" },
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "prefixItems": [
                        { "type": "number", "minimum": -200, "maximum": -60 },
                        { "type": "number", "minimum": 17, "maximum": 72 }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
