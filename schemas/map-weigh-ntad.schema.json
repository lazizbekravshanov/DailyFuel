{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dailyfuel/map-weigh-ntad/1",
  "title": "Weigh station rows of BTS NTAD Truck Stop Parking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source", "source_url", "licence", "licence_note", "attribution", "compiled", "filter",
    "query_url", "fetched", "counts", "sites"
  ],
  "properties": {
    "schema": { "const": "dailyfuel/map-weigh-ntad/1" },
    "source": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "licence": { "type": "string", "pattern": "[Pp]ublic domain" },
    "licence_note": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string", "minLength": 1 },
    "compiled": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "filter": { "type": "string", "minLength": 1 },
    "query_url": { "type": "string", "format": "uri" },
    "fetched": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "sites", "dropped_outside_us"],
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "sites": { "type": "integer", "minimum": 0 },
        "dropped_outside_us": { "type": "integer", "minimum": 0 }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lat", "lon", "name", "state", "route", "milepost", "spots", "id"],
        "properties": {
          "lat": { "type": "number", "minimum": 17, "maximum": 72 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "name": { "type": "string", "minLength": 1 },
          "state": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
          "route": { "type": ["string", "null"], "minLength": 1 },
          "milepost": { "type": ["string", "null"], "minLength": 1 },
          "spots": { "type": ["integer", "null"], "minimum": 0 },
          "id": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
