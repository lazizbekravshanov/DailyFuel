{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dailyfuel/map-stations/1",
  "title": "Branded truck stops from OpenStreetMap, one row per site",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source", "source_url", "licence", "licence_url", "attribution", "attribution_url",
    "query", "osm_base", "fetched", "cluster_m", "brands", "counts", "sites"
  ],
  "properties": {
    "schema": { "const": "dailyfuel/map-stations/1" },
    "source": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "licence": { "type": "string", "pattern": "ODbL" },
    "licence_url": { "type": "string", "format": "uri" },
    "attribution": { "type": "string", "pattern": "OpenStreetMap contributors" },
    "attribution_url": { "type": "string", "format": "uri" },
    "query": { "type": "string", "minLength": 1 },
    "osm_base": { "type": "string", "format": "date-time" },
    "fetched": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "cluster_m": { "type": "integer", "minimum": 1 },
    "brands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "wikidata", "sites"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "wikidata": { "type": ["string", "null"], "pattern": "^Q[0-9]+$" },
          "sites": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elements", "sites", "dropped_ambest", "dropped_outside_us"],
      "properties": {
        "elements": { "type": "integer", "minimum": 0 },
        "sites": { "type": "integer", "minimum": 0 },
        "dropped_ambest": { "type": "integer", "minimum": 0 },
        "dropped_outside_us": { "type": "integer", "minimum": 0 }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lat", "lon", "brand", "name", "osm"],
        "properties": {
          "lat": { "type": "number", "minimum": 17, "maximum": 72 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "brand": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "osm": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[nwr][0-9]+$" }
          }
        }
      }
    }
  }
}
