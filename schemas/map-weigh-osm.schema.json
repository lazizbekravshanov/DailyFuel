{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dailyfuel/map-weigh-osm/1",
  "title": "Weigh and inspection station candidates from OpenStreetMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source", "source_url", "licence", "licence_url", "attribution", "attribution_url",
    "queries", "osm_base", "fetched", "dedupe_m", "note", "counts", "sites"
  ],
  "properties": {
    "schema": { "const": "dailyfuel/map-weigh-osm/1" },
    "source": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "licence": { "type": "string", "pattern": "ODbL" },
    "licence_url": { "type": "string", "format": "uri" },
    "attribution": { "type": "string", "pattern": "OpenStreetMap contributors" },
    "attribution_url": { "type": "string", "format": "uri" },
    "queries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weighbridge", "tags", "names"],
      "properties": {
        "weighbridge": { "type": "string", "minLength": 1 },
        "tags": { "type": "string", "minLength": 1 },
        "names": { "type": "string", "minLength": 1 }
      }
    },
    "osm_base": { "type": "string", "format": "date-time" },
    "fetched": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dedupe_m": { "type": "integer", "minimum": 1 },
    "note": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "required": ["elements", "kept", "candidates", "sites", "via_tag", "via_name", "states", "dropped_outside_us", "dropped_border_outline"],
      "propertyNames": { "pattern": "^[a-z_]+$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lat", "lon", "name", "state", "via", "osm"],
        "properties": {
          "lat": { "type": "number", "minimum": 17, "maximum": 72 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "name": { "type": ["string", "null"], "minLength": 1 },
          "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "via": { "enum": ["tag", "name"] },
          "osm": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[nwr][0-9]+$" }
          }
        }
      }
    }
  }
}
