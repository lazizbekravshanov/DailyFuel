{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dailyfuel/map-coverage/1",
  "title": "How complete the OpenStreetMap map layers are, measured",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "note", "chains", "weigh"],
  "$defs": {
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },
  "properties": {
    "schema": { "const": "dailyfuel/map-coverage/1" },
    "note": { "type": "string", "minLength": 1 },
    "chains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "measured_osm_base", "match_m", "note", "rows"],
      "properties": {
        "measured": { "$ref": "#/$defs/date" },
        "measured_osm_base": { "type": "string", "format": "date-time" },
        "match_m": { "type": "integer", "minimum": 1 },
        "note": { "type": "string", "minLength": 1 },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["brands", "osm_sites", "osm_sites_measured", "official_sites", "matched", "share", "method", "official_source"],
            "properties": {
              "brands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+$" } },
              "osm_sites": { "type": "integer", "minimum": 0 },
              "osm_sites_measured": { "type": "integer", "minimum": 0 },
              "official_sites": { "type": ["integer", "null"], "minimum": 1 },
              "matched": { "type": ["integer", "null"], "minimum": 0 },
              "share": { "$ref": "#/$defs/share" },
              "method": { "type": "string", "minLength": 1 },
              "official_source": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "weigh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "osm_base", "match_km", "official", "matched", "share", "states", "note", "reference"],
      "properties": {
        "measured": { "$ref": "#/$defs/date" },
        "osm_base": { "type": "string", "format": "date-time" },
        "match_km": { "type": "number", "exclusiveMinimum": 0 },
        "official": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 },
        "share": { "$ref": "#/$defs/share" },
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z]{2}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["official", "matched", "layer_filter"],
            "properties": {
              "official": { "type": "integer", "minimum": 0 },
              "matched": { "type": "integer", "minimum": 0 },
              "layer_filter": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        },
        "note": { "type": "string", "minLength": 1 },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "year", "text", "source", "source_url"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "year": { "type": "integer", "minimum": 1990 },
            "text": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "source_url": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
