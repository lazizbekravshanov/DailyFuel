---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL, getSite, REPO_URL } from "../lib/site.ts";
import { formatBadgeDate, formatDate, formatMonthYear } from "../lib/dates.ts";
import { formatPrice } from "../lib/format.ts";
import { DOE_LINE, DYED_DIESEL_NOTE } from "../lib/doe.ts";
import { inSentence, newestRate, spokenCpg } from "../lib/tax.ts";

const site = getSite();
const aaaMode = site.mode === "aaa+eia";
const tax = site.tax;
const taxPage = tax ? `https://www.fhwa.dot.gov/policyinformation/statistics/${tax.reporting_period}/mf121t.cfm` : "";
// Named out loud so nobody has to guess why a state page shows no state figure.
const noTaxFigure = tax
  ? site.states.filter((s) => s.tax?.state == null).map((s) => inSentence(s.name))
  : [];
const staleTax = tax ? site.states.filter((s) => s.tax?.outOfDate).map((s) => inSentence(s.name)) : [];
const newestTax = tax ? newestRate(tax) : null;
/** "Utah", "Minnesota and Utah", "Maine, Minnesota and Utah". */
const inWords = (items: string[]) =>
  items.length < 2 ? items.join("") : `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
const release = site.latest.eia?.release_date ?? site.weekly?.release_date ?? null;
const first = site.weekly?.weeks[0]?.period ?? null;
const us = site.national.move;
const usText = us ? ` The U.S. average is ${formatPrice(us.price)} a gallon ${aaaMode ? "today" : "this week"}.` : "";
const description = aaaMode
  ? `Where DailyFuel's diesel prices come from: AAA daily state averages and EIA weekly prices.${usText}`
  : `Where DailyFuel's diesel prices come from: EIA's weekly survey of diesel stations.${usText}`;
---
<Base title="Where the numbers come from | DailyFuel" description={description} skipLabel="Skip to main content">
  <article class="prose">
    <p class="back"><a href="/">‹ All states</a></p>
    <h1 class="nmbig">Where the numbers come from</h1>

    <section aria-labelledby="weekly">
      <div class="sh"><h2 id="weekly">Weekly prices from EIA</h2></div>
      <p>
        The U.S. Energy Information Administration surveys diesel stations every Monday morning and posts the averages on
        Tuesday, or Wednesday after a Monday holiday. {DOE_LINE}
      </p>
      <p>
        EIA doesn't publish a diesel price for single states, except California. It reports regions instead, so every state
        in a region shows the same weekly price here. The regions are New England, Central Atlantic, Lower Atlantic, Midwest,
        Gulf Coast, Rocky Mountain, California, and the rest of the West Coast.
      </p>
      <p>
        EIA leaves Alaska and Hawaii out of its survey, so those two states have no weekly price.
      </p>
      {first && <p>Charts go back to {formatMonthYear(first)}, when EIA changed how it collects the numbers.</p>}
    </section>

    <section aria-labelledby="not">
      <div class="sh"><h2 id="not">What this number is not</h2></div>
      <ul>
        <li>
          <b>Not the price at one pump.</b> It's an average of many stations, so the one down the road can be
          higher or lower.
        </li>
        <li>
          <b>Not a price before tax.</b> Federal and state taxes are in it. {DYED_DIESEL_NOTE}
        </li>
        <li>
          <b>Not your fleet card price.</b> Card discounts and cost plus deals work off their own numbers, so what
          you pay will differ.
        </li>
      </ul>
    </section>

    <section aria-labelledby="daily">
      <div class="sh"><h2 id="daily">Daily prices</h2></div>
      {aaaMode ? (
        <>
          <p>
            AAA publishes a daily diesel average for every state, with data from OPIS. DailyFuel picks it up once each morning.
          </p>
          <p>
            AAA's daily number and EIA's weekly number usually don't match. They survey different stations on different days,
            and EIA's regions blend many states together. A gap of 50 cents to a dollar is normal.
          </p>
        </>
      ) : (
        <p>
          EIA's number comes out once a week. If you need something fresher, each state page links to AAA's daily average
          for that state.
        </p>
      )}
    </section>

    {tax && (
      <section aria-labelledby="tax">
        <div class="sh"><h2 id="tax">Tax on every gallon</h2><p class="meta">FHWA table MF-121T, {tax.reporting_period}</p></div>
        <p>
          Every state taxes diesel, and the federal government adds {spokenCpg(tax.federal_cpg)} on top. Each state page
          shows the tax on a gallon there and where the state ranks.
        </p>
        <p>
          Keep the tax apart from the prices here. It comes from a different source and covers a different time,
          {aaaMode ? "" : " and most prices here are regional averages,"} so taking the tax off a price won't tell you
          what diesel costs before tax.
        </p>
        <p>
          The rates come from the Federal Highway Administration, which collects them from the states once a year. This
          is FHWA's {tax.reporting_period} table.{newestTax && ` The newest rate in it took effect in ${formatMonthYear(newestTax)}, so a change after that isn't in yet.`}
          {" "}Many states change their rate every year, so check with the state before you count on a figure. Each
          state page says when its rate took effect.
        </p>
        <p>{tax.scope}</p>
        {noTaxFigure.length > 0 && (
          <p>
            FHWA's table has no diesel rate for {inWords(noTaxFigure)}, so {noTaxFigure.length === 1 ? "that page shows" : "those pages show"} only the federal rate. That
            doesn't mean there's no tax on diesel there.
          </p>
        )}
        {staleTax.length > 0 && (
          <p>
            {staleTax.length === 1 ? "FHWA's rate" : "FHWA's rates"} for {inWords(staleTax)} {staleTax.length === 1 ? "is" : "are"} known to be out of date, so {staleTax.length === 1 ? "that page says so and it isn't" : "those pages say so and they aren't"} ranked.
          </p>
        )}
      </section>
    )}

    <section aria-labelledby="updates">
      <div class="sh"><h2 id="updates">How often it updates</h2></div>
      <p>
        {aaaMode
          ? "The site checks for new numbers three times a day. Daily prices usually change each morning, and EIA's weekly prices change on Tuesdays."
          : "The site checks for new numbers three times a day. EIA's weekly prices change on Tuesdays."}
        {" "}If prices look older than usual, a note at the top of the page says so.
      </p>
    </section>

    <section aria-labelledby="contact">
      <div class="sh"><h2 id="contact">Spot a wrong number?</h2></div>
      {CONTACT_EMAIL ? (
        <p>
          Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Say which page and what looks off, and we'll check it
          against the source.
        </p>
      ) : (
        <p>
          Tell us on <a href={`${REPO_URL}/issues/new`}>GitHub</a>. Say which page and what looks off, and we'll check it
          against the source.
        </p>
      )}
    </section>

    <section aria-labelledby="credits">
      <div class="sh"><h2 id="credits">Credits</h2></div>
      <p>
        Weekly prices: U.S. Energy Information Administration, Gasoline and Diesel Fuel Update{release ? ` (released ${formatDate(release)})` : ""}.
        EIA data is public domain.
      </p>
      {aaaMode && site.latest.aaa && (
        <p>
          Daily state averages: AAA (<a href="https://gasprices.aaa.com/">gasprices.aaa.com</a>), data by OPIS. Price as of {formatBadgeDate(site.latest.aaa.as_of)}.
          DailyFuel is not affiliated with AAA or OPIS. AAA and OPIS data is not covered by DailyFuel's code license.
        </p>
      )}
      {tax && (
        <p>
          Diesel tax: Federal Highway Administration, Highway Statistics{" "}
          <a href={taxPage}>table MF-121T</a> ({tax.reporting_period} reporting period, published {formatMonthYear(tax.published)}).
          FHWA data is a U.S. government work in the public domain.
        </p>
      )}
      <p>
        Type: the monospace font already on your phone or computer. The site loads no font of its own. The share images are
        set in Red Hat Mono by the Red Hat Project Authors, under the{" "}
        <a href="https://openfontlicense.org/">SIL Open Font License 1.1</a>, from the{" "}
        <a href="https://github.com/RedHatOfficial/RedHatFont">Red Hat font project</a>.
      </p>
      <p>DailyFuel's own code is MIT licensed.</p>
    </section>
  </article>
</Base>
