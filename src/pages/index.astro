---
import Base from "../layouts/Base.astro";
import Sign from "../components/Sign.astro";
import Price from "../components/Price.astro";
import UsMap from "../components/UsMap.astro";
import TileMap from "../components/TileMap.astro";
import Legend from "../components/Legend.astro";
import BiggestMoves, { type MoveItem } from "../components/BiggestMoves.astro";
import RegionMultiples from "../components/RegionMultiples.astro";
import StateTable from "../components/StateTable.astro";
import UsSparkline from "../components/UsSparkline.astro";
import YourState from "../components/YourState.astro";
import Icon from "../components/Icon.astro";
import rollScript from "../scripts/roll.js?raw";
import mapScript from "../components/home/map.js?raw";
import chartScript from "../scripts/chart.js?raw";
import sortScript from "../scripts/table-sort.js?raw";
import { getSite, SITE_NAME } from "../lib/site.ts";
import { formatShortDate, formatWeekdayDate, todayInNewYork } from "../lib/dates.ts";
import { LATE_TEXT, nextEiaRelease } from "../lib/release.ts";
import { changeTenths, formatCents } from "../lib/format.ts";
import { directionFor } from "../lib/bins.ts";
import { countPlaces, missingNote, pctOf, sinceText } from "../lib/copy.ts";
import { peakKind } from "../lib/stats.ts";
import { allRegionsSentence, DOE_LINE, HOME_TITLE } from "../lib/doe.ts";
import { homeMeta, keyLine, leaders, movers } from "../components/home/home.ts";

const site = getSite();
const { mode, national, latest } = site;
const aaaMode = mode === "aaa+eia";
const daily = national.cadence === "daily";

const dateLine = daily ? `Price as of ${formatShortDate(national.date)}` : `Week of ${formatShortDate(national.date)}`;
const nm = national.move;
const compareLine = !nm || nm.change === null
  ? null
  : daily
    ? "vs yesterday"
    : national.prevDate
      ? `vs week of ${formatShortDate(national.prevDate)}`
      : null;

// Biggest moves: states when AAA is on, regions otherwise. A region carries its
// member states so the list can say who shares the price.
const moveItems: MoveItem[] = aaaMode
  ? site.states
      .filter((s) => s.primary && s.primary.change !== null)
      .map((s) => ({ code: s.code, name: s.name, href: s.href, price: s.primary!.price, change: s.primary!.change!, pct: pctOf(s.primary!) }))
  : site.regions
      .filter((r) => r.move && r.move.change !== null)
      .map((r) => ({
        name: r.name,
        price: r.move!.price,
        change: r.move!.change!,
        pct: pctOf(r.move!),
        members: r.states.map((code) => ({ code, name: site.byCode.get(code)?.name ?? code })),
      }));
// Rises and falls follow the map bins, so a move the map and key call about
// the same is never named as the biggest rise or drop.
const moveCadence = aaaMode ? "daily" : "weekly";
const rises = movers(moveItems, "up", moveCadence);
const falls = movers(moveItems, "down", moveCadence);

// The plain sentences beside the sign.
const where = daily ? "since yesterday" : "this week";
const usMove = nm?.change ?? null;
// The sign's plaque uses the same bins, so a U.S. move under the about the
// same line isn't called a rise or a fall here either.
const usDir = usMove === null ? null : directionFor(usMove, national.cadence);
const usSentence = usMove === null
  ? "Here's where diesel prices stand in every state."
  : changeTenths(usMove) === 0
    ? `Diesel held steady across the U.S. ${where}.`
    : usDir === "flat"
      ? `Diesel was about the same across the U.S. ${where}, ${changeTenths(usMove) > 0 ? "up" : "down"} ${formatCents(usMove)}.`
      : `Diesel ${usDir === "up" ? "rose" : "fell"} ${formatCents(usMove)} across the U.S. ${where}.`;
const noun = aaaMode ? "state" : "region";
const stateWhere = aaaMode ? sinceText(site) || where : where;
// Name the period on the rise and fall lines when it differs from the U.S. line,
// like a skipped AAA day (states since Sep 15, AAA's national since yesterday).
const moveWhen = stateWhere === where ? "" : ` ${stateWhere}`;
// Everyone tied for the biggest move gets named, never just the first by name.
// More than 3 tied reads as a count instead of a long list.
const tiedRise = leaders(rises);
const tiedFall = leaders(falls);
const topRise = tiedRise[0];
const topFall = tiedFall[0];
const tiedCount = (tied: MoveItem[]) => (aaaMode ? countPlaces(tied as { code: string }[], false) : `${tied.length} ${noun}s`);
// Say the high in words, only when it's true: every stored week of a region
// sits strictly below this one. Computed from the 8 benchmark series.
// With AAA on, the sign is a daily number, so say these are EIA's regions.
const regionPeak = site.weekly ? allRegionsSentence(site.regions.map((r) => peakKind(r.history))) : null;
const peakLine = regionPeak && aaaMode ? regionPeak.replace("region", "EIA region") : regionPeak;
// The same holiday aware date the state pages use. EIA's own next release date
// wins when it points past this week; otherwise the usual Tuesday schedule.
const release = nextEiaRelease(
  latest.eia?.period ?? null,
  latest.eia?.next_release_date ?? site.weekly?.next_release_date ?? null,
  todayInNewYork(),
);
const eiaNext = release?.date ?? null;
// The EIA sentence carries its date so the stale script can swap in a late
// notice when the page is read after that day and nothing new has landed.
const nextDaily = aaaMode ? "Daily prices update every morning." : null;
const nextEia = eiaNext
  ? aaaMode
    ? `EIA's next weekly numbers land ${formatWeekdayDate(eiaNext)}.`
    : `EIA posts next week's prices on ${formatWeekdayDate(eiaNext)}.`
  : aaaMode
    ? null
    : "EIA posts new prices every Tuesday.";
// Our update can miss a release EIA posted on time (the last run of the day is
// before EIA's latest posting time), so the late line says the update is late
// and doesn't blame EIA.
const eiaLate = aaaMode ? "The next weekly EIA update is running late." : LATE_TEXT;
// The build already knows the date, so a page read with JS off doesn't promise
// a release day that has passed. The inline script still corrects a page that
// is served for days after the build.
const eiaIsLate = Boolean(release?.late);

// Day one after the AAA switch flips, no state has a yesterday, so the two
// "no state went up / down" lines would contradict the national change above them.
const dayOne = aaaMode && moveItems.length === 0;

// Name the states that actually carry the no data fill. Hardcoding Alaska and
// Hawaii goes wrong the moment a surveyed region has a blank week.
const nodataStates = site.states.filter((s) => s.fill === "nodata");
const unsurveyed = nodataStates.filter((s) => s.eia_series === null);
const noDataLabel = nodataStates.length === 0
  ? null
  : aaaMode
    ? "No change yet"
    : unsurveyed.length === nodataStates.length
      ? `No EIA survey (${unsurveyed.map((s) => s.name).join(", ")})`
      : "No price this week";
const mapWhat = aaaMode ? (sinceText(site) || "since the last price") : sinceText(site);
const mapLabel = `Map of the diesel price change by state ${mapWhat}. Each state links to its page.`;
// One line above the map key, from the data: "All 8 regions rose, 21.2¢ to 49.1¢."
const keySummary = keyLine(moveItems, noun, moveCadence);
const periodText = aaaMode
  ? latest.aaa?.prev_as_of
    ? `Daily AAA averages, ${formatShortDate(latest.aaa.prev_as_of)} to ${formatShortDate(latest.aaa.as_of)}.`
    : "Daily AAA averages."
  : latest.eia?.prev_period
    ? `EIA weekly prices, week of ${formatShortDate(latest.eia.prev_period)} to week of ${formatShortDate(latest.eia.period)}.`
    : "EIA weekly prices.";

// The DOE name is how drivers and surcharge contracts know the weekly number.
// It only fits while the sign shows EIA's weekly U.S. average.
const doeSign = !daily;
const title = doeSign ? `${HOME_TITLE} | ${SITE_NAME}` : `Diesel prices in every state, and which way they moved | ${SITE_NAME}`;
// Names only the places that have a price, so it never promises Alaska and
// Hawaii while EIA doesn't survey them, then says why the rest are missing.
const description = homeMeta({
  price: nm?.price ?? null,
  change: nm?.change ?? null,
  daily,
  priced: site.states.filter((s) => s.primary !== null).map((s) => s.code),
  regions: aaaMode ? undefined : site.regions.length,
}) + missingNote(site);
---
<Base title={title} description={description}>
  <section class="hero wrap" aria-label="U.S. average">
    <div class="hero-sign">
      <Sign
        legend="U.S. diesel average"
        price={nm?.price ?? null}
        noPrice="No national price today"
        change={nm?.change ?? null}
        pct={nm ? pctOf(nm) : null}
        prev={nm?.prev ?? null}
        cadence={national.cadence}
        dateLine={dateLine}
        compareLine={compareLine}
        roll
        note={Boolean(aaaMode && site.eiaUs && latest.eia && daily)}
      >
        {aaaMode && site.eiaUs && latest.eia && daily && (
          <p slot="note">EIA weekly average: <Price price={site.eiaUs.price} /> for the week of {formatShortDate(latest.eia.period)}</p>
        )}
      </Sign>
      <script is:inline set:html={rollScript}></script>
      {doeSign && <p class="doe small muted">{DOE_LINE}</p>}
      {/* Under the U.S. sign, so on a phone the driver's own state is in the
          first screen. It takes the same 64px saved or not. */}
      <YourState />
    </div>
    <div class="summary">
      <p class="lead">{usSentence}</p>
      {peakLine && <p class="peak">{peakLine}</p>}
      {site.weekly && <UsSparkline site={site} class="spark-slot" />}
      {dayOne && <p>This is the first day of daily state prices, so there's nothing to compare yet.</p>}
      {topRise && (
        <p>
          {tiedRise.length > 3 ? `${tiedCount(tiedRise)} tied for the biggest rise${moveWhen}, up ${formatCents(topRise.change)} each.` : (
            <>{tiedRise.map((i, k) => <>{k > 0 && (k === tiedRise.length - 1 ? " and " : ", ")}{aaaMode ? <a href={i.href}>{i.name}</a> : i.name}</>)} rose the most{moveWhen}, up {formatCents(topRise.change)}.</>
          )}
        </p>
      )}
      {!topRise && !dayOne && <p>No {noun} went up {stateWhere}.</p>}
      {topFall ? (
        <p>
          {tiedFall.length > 3 ? `${tiedCount(tiedFall)} tied for the biggest drop${moveWhen}, down ${formatCents(topFall.change)} each.` : (
            <>{tiedFall.map((i, k) => <>{k > 0 && (k === tiedFall.length - 1 ? " and " : ", ")}{aaaMode ? <a href={i.href}>{i.name}</a> : i.name}</>)} fell the most{moveWhen}, down {formatCents(topFall.change)}.</>
          )}
        </p>
      ) : !dayOne ? (
        <p>No {noun} went down {stateWhere}.</p>
      ) : null}
      <p class="muted">
        <Icon name="next-update" size={17} class="next-mark" />{nextDaily}{nextDaily && nextEia ? " " : ""}{nextEia && (
          <span data-next-release={eiaNext ?? undefined} data-late={eiaLate}>{eiaIsLate ? eiaLate : nextEia}</span>
        )}
      </p>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="map-title">
    <div class="section-head">
      <h2 id="map-title">Where diesel went up or down</h2>
      <p>{periodText} Tap a state to see its price and chart.</p>
    </div>
    <div class="map-layout">
      <div class="map-col">
        <a class="skip-map" href="#after-map">Skip past the map</a>
        <div class="geo-map">
          <UsMap site={site} label={mapLabel} />
        </div>
        <div class="tile-map">
          <TileMap site={site} label={mapLabel} />
        </div>
        <span id="after-map" tabindex="-1"></span>
        {!aaaMode && (
          <p class="map-note small muted">EIA reports diesel by region, so states in the same region share a price.</p>
        )}
      </div>
      {/* not an aside: a complementary landmark can't sit inside main, and the
          key and the move list carry their own headings */}
      <div class="map-side">
        <Legend
          cadence={national.cadence === "daily" || aaaMode ? "daily" : "weekly"}
          noData={noDataLabel}
          title={aaaMode ? `Change ${sinceText(site) || "since the last price"}` : "Change since last week"}
          summary={keySummary}
        />
        <BiggestMoves
          items={moveItems}
          cadence={moveCadence}
          noun={noun}
          layout={aaaMode ? "split" : "list"}
          count={5}
          empty={dayOne ? "No state has a change yet." : `No ${noun} has a change yet.`}
        />
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="states-title">
    <div class="section-head">
      <h2 id="states-title">Every state</h2>
    </div>
    <StateTable site={site} />
  </section>

  {site.weekly && (
    <section class="section wrap" aria-labelledby="regions-title">
      <div class="section-head">
        <h2 id="regions-title">Regions, last 52 weeks</h2>
        <p>EIA's weekly price for its 8 diesel regions, all on the same scale.</p>
      </div>
      <RegionMultiples site={site} />
    </section>
  )}

  <Fragment slot="scripts">
    <script is:inline set:html={mapScript}></script>
    <script is:inline set:html={chartScript}></script>
    <script is:inline set:html={sortScript}></script>
  </Fragment>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--space-6) var(--space-7);
    align-items: center;
    padding-block: var(--space-7) var(--space-7);
  }
  .summary {
    font-size: 19px;
    line-height: 1.5;
  }
  .summary p {
    margin-bottom: var(--space-3);
  }
  .summary .lead {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.3;
  }
  .summary .muted {
    font-size: 17px;
  }
  .summary :global(.next-mark) {
    margin-right: 8px;
  }
  .hero-sign :global(.your-state) {
    margin-top: var(--space-5);
  }
  .doe {
    margin: var(--space-3) 0 0;
    max-width: 62ch;
  }
  /* the U.S. line sits between the peak line and the moves, with air on both sides */
  .summary :global(.spark-slot) {
    margin: var(--space-4) 0 var(--space-5);
  }
  @media (max-width: 899px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--space-5) var(--space-6);
    }
    .summary {
      font-size: 17px;
    }
  }

  .map-layout {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--space-6) var(--space-7);
    align-items: start;
  }
  @media (max-width: 1023px) {
    .map-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .map-side {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--space-6);
    }
  }
  .map-side {
    display: grid;
    gap: var(--space-6);
  }
  /* the skip link sits above both maps, so it works for the tiles on a phone too */
  .map-col {
    position: relative;
  }
  .skip-map {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 6;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    border-radius: 4px;
    transform: translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }
  .skip-map:focus {
    transform: none;
    opacity: 1;
    pointer-events: auto;
  }
  /* when the moves list runs longer than the map, the map stays in view beside it */
  @media (min-width: 1024px) {
    .map-col {
      position: sticky;
      top: var(--space-4);
    }
  }
  .tile-map {
    display: none;
  }
  @media (max-width: 639px) {
    .geo-map {
      display: none;
    }
    .tile-map {
      display: block;
    }
  }
  .map-note {
    margin-top: var(--space-3);
  }

  /* hero roll reels */
  .hero :global(.dg) {
    position: relative;
    display: inline-block;
    line-height: 1;
  }
  /* the window shows one digit at rest: cap top to just under the baseline,
     so a digit coming up the reel never shows in the gap above the date line */
  .hero :global(.dg.rolling) {
    color: transparent;
    clip-path: inset(-0.02em -0.3em 0.2em -0.3em);
  }
  .hero :global(.dg .reel) {
    position: absolute;
    left: -0.5em;
    right: -0.5em;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--sign-ink);
  }
  .hero :global(.dg .reel > span) {
    display: block;
    height: 1em;
    line-height: 1;
  }
</style>
