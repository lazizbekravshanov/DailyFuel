---
// The home page, in the paper terminal. Your state first once one is saved,
// its price the headline; then the U.S. average with its change in words, the
// week, and the picker; then the prices by region, each with its states; then
// every state in one sortable table. On a phone the U.S. chart and the full
// table are one tap away, so the answers fit on the first two screens. Every
// printed value comes from the data.
import Base from "../layouts/Base.astro";
import "../styles/home.css";
import YourState from "../components/YourState.astro";
import UsChart from "../components/home/UsChart.astro";
import RegionsBoard from "../components/home/RegionsBoard.astro";
import Quotes from "../components/home/Quotes.astro";
import { spark, type Spark } from "../components/home/chart.ts";
import { homeMeta, homeTitle } from "../components/home/home.ts";
import { quotes } from "../components/home/quotes.ts";
import { readout } from "../components/home/readout.ts";
import { moveClass } from "../lib/bins.ts";
import { missingNote, pctOf } from "../lib/copy.ts";
import { peakSentence } from "../lib/doe.ts";
import { formatDate, formatShortDate, todayInNewYork } from "../lib/dates.ts";
import { changeTenths, changeWords, formatMove, formatPrice } from "../lib/format.ts";
import { inlineCall } from "../lib/inline.ts";
import { formatShortWeekdayDate, LATE_TEXT, nextEiaRelease, nextUpdateText } from "../lib/release.ts";
import { homeShareText } from "../lib/share.ts";
import { getSite, weeklySeries } from "../lib/site.ts";
import { changeOver, peakKind } from "../lib/stats.ts";

const site = getSite();
const { national, latest } = site;
const daily = national.cadence === "daily";
const aaaMode = site.mode === "aaa+eia";
const nm = national.move;

// The headline: the price, and its change in the ink of its direction (muted
// when the bins call it about the same). On a phone the words line says it.
const move = nm && nm.change !== null ? formatMove(nm.change, pctOf(nm)) : null;
const ink = nm ? moveClass(nm.change, national.cadence) : "muted";

// The change in words, its ink only on the change: "Down 14.7¢ from $6.529 last week."
const since = daily ? "yesterday" : "last week";
const t = nm && nm.change !== null ? changeTenths(nm.change) : null;
const fromText = !nm || t === null ? "" : t === 0 || nm.prev === null ? `from ${since}.` : `from ${formatPrice(nm.prev)} ${since}.`;
const usSeries = weeklySeries(site.weekly, "NUS");
// How high the U.S. price is, said only while the headline is EIA's weekly
// number, which is what the records are. The regions' records go with the board.
const usPeak = daily ? null : peakSentence(peakKind(usSeries), "U.S.");

// Which week, and when the next numbers land. EIA's own next release date,
// checked against the holiday schedule; the stale script turns it into the
// late notice in the browser once that day has passed with nothing new.
const release = latest.eia
  ? nextEiaRelease(latest.eia.period, latest.eia.next_release_date ?? site.weekly?.next_release_date ?? null, todayInNewYork())
  : null;
const week = daily ? `Prices as of ${formatDate(national.date)}.` : `Prices for the week of ${formatDate(national.date)}.`;
const nextText = release ? (aaaMode ? `EIA's next weekly numbers land ${formatShortWeekdayDate(release.date)}.` : nextUpdateText(release.date)) : null;
const late = aaaMode ? "The next weekly EIA update is running late." : LATE_TEXT;

// Then, in two prices, for a phone that has the chart folded away.
const fourAgo = usSeries.length ? changeOver(usSeries, 28, 0) : null;
const yearAgo = usSeries.length ? changeOver(usSeries, 364, 0) : null;
const then = [fourAgo && `4 weeks ago ${formatPrice(fourAgo.from.value)}.`, yearAgo && `A year ago ${formatPrice(yearAgo.from.value)}.`].filter(Boolean).join(" ");

// The picker, A to Z by name.
const picks = [...site.states].sort((a, b) => a.name.localeCompare(b.name));

// The 52 week lines the two tables share, drawn once into a sprite.
const sparks = new Map<string, Spark>();
if (site.weekly) {
  const us = spark(usSeries);
  if (us) sparks.set("NUS", us);
  for (const r of site.regions) {
    const s = spark(r.history);
    if (s) sparks.set(r.key, s);
  }
}

const title = homeTitle(nm?.price ?? null, nm?.change ?? null);
// Names only the places that have a price, so it never promises Alaska and
// Hawaii while EIA doesn't survey them, then says why the rest are missing.
const description = homeMeta({
  price: nm?.price ?? null,
  change: nm?.change ?? null,
  daily,
  priced: site.states.filter((s) => s.primary !== null).map((s) => s.code),
  regions: aaaMode ? undefined : site.regions.length,
}) + missingNote(site);
const share = homeShareText(site);
const readoutScript = inlineCall(readout, "document");
const quotesScript = inlineCall(quotes, "document");
---
<Base title={title} description={description} share={share}>
  <YourState>
    {week}{nextText && <> <span data-next-release={release?.date} data-late={late}>{release?.late ? late : nextText}</span></>}
  </YourState>

  <section class="hero" aria-label="U.S. average">
    <div class="lead">
      <h1 class="lbl">U.S. diesel average</h1>
      {nm ? (
        <p class="big"><span>{formatPrice(nm.price)}</span>{move && <span class:list={["d", ink]}>{move}</span>}</p>
      ) : (
        <p class="big"><span>No national price</span></p>
      )}
      {nm && nm.change !== null && <p class="chw"><b class={ink}>{changeWords(nm.change)}</b> {fromText}</p>}
      {usPeak && <p class="note">{usPeak}</p>}
      {aaaMode && site.eiaUs && latest.eia && (
        <p class="note fine">EIA weekly average: {formatPrice(site.eiaUs.price)} for the week of {formatShortDate(latest.eia.period)}.</p>
      )}
      <p class="wkl">
        {week}{nextText && <> <span data-next-release={release?.date} data-late={late}>{release?.late ? late : nextText}</span></>}
      </p>
      {/* With JS on, the page's script saves the pick and opens its page; with
          JS off the form goes to /go, which vercel.json sends to the state's page.
          The id keeps every old /#find-your-state link landing here. */}
      <form class="go" action="/go" id="find-your-state">
        <label class="lbl" for="go-s"><span class="g1">Your state</span><span class="g2">Change your state</span></label>
        <div class="go-r">
          <select id="go-s" name="s" required>
            <option value="">Pick your state</option>
            {picks.map((s) => <option value={s.slug}>{s.name}</option>)}
          </select>
          <button class="btn">Show price</button>
        </div>
      </form>
      {then && <p class="then">{then}</p>}
    </div>
    {site.weekly && (
      <>
        <input type="checkbox" id="usc" class="sr-only" />
        <label for="usc" class="btn wide usc-l"><span class="o1">Show the U.S. price chart</span><span class="o2">Hide the U.S. price chart</span></label>
        <UsChart series={usSeries} name={aaaMode ? "EIA U.S. average" : "U.S. average"} spoken={aaaMode ? "EIA weekly U.S. diesel average" : "U.S. weekly diesel average"} id="c-us" />
      </>
    )}
  </section>

  {site.weekly && <RegionsBoard site={site} sparks={sparks} />}

  <Quotes site={site} sparks={sparks} />

  {/* far from Change your state, so a gloved thumb can't hit it by mistake */}
  <p class="fg fine">This phone remembers your state. <button type="button" class="btn" data-ys-forget>Forget my state</button></p>

  {sparks.size > 0 && (
    <svg class="sprite" aria-hidden="true" focusable="false">
      {/* Presentation attributes, not CSS: document styles do not reach the
          clones a <use> makes, so a styled path would paint as a filled shape. */}
      <defs>
        {[...sparks].map(([key, s]) => (
          <g id={`spk-${key}`}>
            <path fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" stroke-width="1" d={s.d}></path>
            <path fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" stroke-width="3" stroke-linecap="round" d={s.end}></path>
          </g>
        ))}
      </defs>
    </svg>
  )}

  <Fragment slot="scripts">
    <script is:inline set:html={readoutScript}></script>
    <script is:inline set:html={quotesScript}></script>
  </Fragment>
</Base>
