---
import Base from "../layouts/Base.astro";
import { getSite } from "../lib/site.ts";
import { formatPrice } from "../lib/format.ts";

const site = getSite();
const states = [...site.states].sort((a, b) => a.name.localeCompare(b.name));
---
<Base
  title="Page not found | DailyFuel"
  description={`That page isn't here.${site.national.move ? ` U.S. diesel averages ${formatPrice(site.national.move.price)} a gallon.` : ""} Find any state's price from the home page.`}
  noindex
>
  <div class="wrap missing">
    <h1>That page isn't here</h1>
    <p>The link may be old or mistyped. State pages use the two letter code, like /state/oh/ for Ohio.</p>
    <p><a href="/">See diesel prices for every state</a></p>
    <h2>Jump to a state</h2>
    <ul class="state-list">
      {states.map((s) => <li><a href={s.href}>{s.name}</a></li>)}
    </ul>
  </div>
</Base>

<style>
  .missing {
    padding-block: var(--space-7) var(--space-8);
  }
  h1 {
    margin-bottom: var(--space-4);
  }
  h2 {
    font-size: var(--fs-h3);
    margin: var(--space-6) 0 var(--space-3);
  }
  .state-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 4 140px;
    column-gap: var(--space-5);
  }
  .state-list li {
    padding: 3px 0;
    break-inside: avoid;
  }
</style>
