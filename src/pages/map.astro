---
// /map: truck stops, weigh stations and truck service points on one map, in
// the paper terminal. The base map (baseMap in src/components/map/page.ts:
// CARTO with a key, else OpenStreetMap), in grey and inverted in dark mode,
// is the one request to another host; the freight roads from
// data/map are drawn over it up to zoom 10. Leaflet 1.9.4 is self hosted under
// /vendor/leaflet/, the markers are drawn on a canvas, and one inline module
// (src/scripts/map.ts) runs the filters, the popups, the list and the route
// strip. With JS off the page is the legend, the coverage numbers, the
// credits and the whole list as a table.
import Base from "../layouts/Base.astro";
import { CHAINS } from "../components/map/chains.ts";
import { baseMap, jsonBlock, mapConfig, mapScript, rowsHtml, tally } from "../components/map/page.ts";
import { formatDate } from "../lib/dates.ts";
import { andList, coverageLine, loadMapData } from "../lib/mapdata.ts";
import { getSite } from "../lib/site.ts";

const site = getSite();
const data = loadMapData();
const t = tally(data);
const cfg = mapConfig(site, data);
const bm = baseMap();
const fmt = (n: number) => n.toLocaleString("en-US");
const total = data.points.length;
const cov = coverageLine(data.coverage);
const weigh = data.coverage.weigh;
const ref = weigh.reference;
const checked = Object.keys(weigh.states).length;
const osmDate = formatDate(data.osmBase.slice(0, 10));
// DailyFuel's own list in the weigh layer: every marker it is part of, and the ones no open source has
const fleetWeigh = data.points.filter((p) => p.kind === "w" && p.sources.includes("f")).length;
const fleetOnly = data.points.filter((p) => p.kind === "w" && p.sources === "f").length;
const taxYear = site.tax?.reporting_period ?? null;

const title = "Truck stop and weigh station map | DailyFuel";
const description =
  `${fmt(t.stops)} truck stops from seven chains and ${fmt(t.weigh)} weigh stations` +
  (t.service ? `, plus ${fmt(t.service)} truck repair and lube shops,` : "") +
  " on one map from open data, with the weekly diesel price and the state tax along a trip.";
---
<Base title={title} description={description} skipLabel="Skip to the page">
  <link slot="head" rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
  <link slot="head" rel="preconnect" href={bm.origin} />
  <div class="mp">
    <div class="mp-head">
      <h1 class="mp-h">Truck stops and weigh stations</h1>
      <p class="mp-in">Zoom in, then tap a dot to see what it is. Not every truck stop or scale is on the map.</p>
    </div>
    {/* jump to a town or a state, or to where the phone is; the script enables it */}
    <form id="fd" class="fd" autocomplete="off">
      <fieldset disabled>
        <legend class="sr-only">Find a place on the map</legend>
        <label class="rt-f fd-q"><span class="sr-only">Town or state</span><input name="q" list="pl" placeholder="Town or state" spellcheck="false" /></label>
        <button class="btn">Show</button>
        <button class="btn" type="button" data-near>Near me</button>
      </fieldset>
    </form>
    <p class="fine rt-st" id="fd-st" role="status"></p>

    <div class="mp-top">
      <div class="mp-mc">
        <div
          id="map"
          class="mp-map"
          role="region"
          aria-label="Map of truck stops and weigh stations. Arrow keys pan, plus and minus zoom. Every marker is also in the list below."
        >
          <p class="mp-msg">The map needs JavaScript. Every place on it is in the list below.</p>
        </div>
        <p class="fine mp-tip">Use two fingers to move the map, or tap + and −.</p>
        {/* the credit the tiles need, next to the map; every source is named in Map credits at the end of the page */}
        <p class="fine mp-attr">
          {bm.credit.name === "CARTO" && <><a href={bm.credit.href}>© CARTO</a> <span class="dot">·</span> </>}<a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a> <span class="dot">·</span> <a href="#credits">Map credits</a>
        </p>

        <section class="mp-rt" id="trip" aria-labelledby="rt-h">
          <div class="sh">
            <h2 id="rt-h">Prices along a trip</h2>
            <p class="meta">{cfg.wk}{taxYear && <> <span class="dot">·</span> {taxYear} state tax</>}</p>
          </div>
          <form id="rt" class="rt" autocomplete="off">
            <fieldset disabled>
              <legend class="sr-only">Where the trip starts and ends</legend>
              <label class="rt-f"><span>From</span><input name="a" list="pl" placeholder="Town, like Chicago, IL" spellcheck="false" /></label>
              <label class="rt-f"><span>To</span><input name="b" list="pl" placeholder="Town, like Denver, CO" spellcheck="false" /></label>
              <button class="btn wide" type="submit">Show prices</button>
            </fieldset>
            <datalist id="pl"></datalist>
          </form>
          <noscript><p class="fine">Prices along a trip needs JavaScript.</p></noscript>
          {/* the answer and any error come right under the button, where the keyboard can't cover them */}
          <p class="fine rt-st" id="rt-st" role="status"></p>
          <div id="rt-out"></div>
          <p class="note">
            This follows a straight line, not the roads you will drive. Each price is the region's weekly average, and pumps in one state can differ by more than a dollar, so check the chain's website for today's price.
          </p>
        </section>
      </div>

      <aside class="mp-lg" aria-labelledby="lg-h">
        <div class="sh"><h2 id="lg-h">What is on the map</h2><p class="meta">Tap to show or hide</p></div>
        {/* on a phone the key and its filters wait behind one button */}
        <input type="checkbox" id="lgt" class="sr-only" />
        <label for="lgt" class="btn wide lgt-l"><span class="o1">Show the key and filters</span><span class="o2">Hide the key and filters</span></label>
        <fieldset class="lg">
          <legend class="sr-only">Show on the map and in the list</legend>
          <p class="lbl">Truck stops</p>
          {CHAINS.map((ch) => (
            <label class="lg-i">
              <input type="checkbox" data-k={ch.key} checked disabled />
              <span class="key" aria-hidden="true">{ch.letter}</span>
              <span>{ch.name}</span>
              <span class="n">{fmt(data.counts[ch.key] ?? 0)}</span>
            </label>
          ))}
          <p class="lbl">Other points</p>
          <label class="lg-i">
            <input type="checkbox" data-k="w" checked disabled />
            <span class="key kw" aria-hidden="true"></span>
            <span>Weigh stations</span>
            <span class="n">{fmt(t.weigh)}</span>
          </label>
          {t.service > 0 && (
            <label class="lg-i">
              <input type="checkbox" data-k="v" checked disabled />
              <span class="key kv" aria-hidden="true"></span>
              <span>Repair and lube</span>
              <span class="n">{fmt(t.service)}</span>
            </label>
          )}
        </fieldset>
        <p class="fine">Not every truck stop or scale is on the map. A missing dot doesn't mean there is none.</p>
        <details class="more">
          <summary class="btn wide">How complete is this map?</summary>
          <p class="fine">
            How much of each chain's own list of stops is on the map: {cov.measured}.
            {cov.unmeasured.length > 0 && ` ${andList(cov.unmeasured)} ${cov.unmeasured.length === 1 ? "publishes" : "publish"} no count to check against.`}
          </p>
          <p class="fine">
            Some weigh stations are missing. OpenStreetMap had {weigh.share === null ? "some" : `${Math.round(weigh.share * 100)}%`} of the official ones in the {checked} states we could check.
            {data.present.fleet && ` DailyFuel's own list adds more: ${fmt(fleetWeigh)} of the scales on the map are on it, and ${fmt(fleetOnly)} of those are on no open source.`}
            {" "}If you don't see a scale, there may still be one.
          </p>
          <p class="fine">Chain names only say whose stop it is. DailyFuel is not affiliated with or endorsed by any chain.</p>
        </details>
      </aside>
    </div>

    <section class="mp-ls" aria-labelledby="ls-h">
      <div class="sh"><h2 id="ls-h">List</h2><p class="meta" id="ls-n">{fmt(total)} places</p></div>
      <details id="ls-d">
      <summary class="btn"><span class="ls-o">Show</span><span class="ls-c">Hide</span> the list</summary>
      <p class="fine">Every place on the map. With the map on, the list shows what is in view.</p>
      <a class="skip" href="#ls-end">Skip past the list</a>
      <div class="scroll mlist" tabindex="0" role="region" aria-label="List of every place on the map, scrolls">
        <table id="ls">
          <thead>
            <tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">State</th></tr>
          </thead>
          <tbody set:html={rowsHtml(data.points)} />
        </table>
      </div>
      <p class="fine" id="ls-end" tabindex="-1">End of the list.</p>
      </details>
    </section>

    <section class="mp-cr" aria-labelledby="credits">
      <div class="sh"><h2 id="credits">Map credits</h2></div>
      <p class="fine">
        {bm.credit.name === "CARTO" ? <>Base map <a href={bm.credit.href}>© CARTO</a>, map data and stops </> : "Base map, map data and stops "}<a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors, ODbL</a>, extract of {osmDate}.
        {" "}More weigh stations: U.S. DOT NTAD (public domain) and Iowa DOT (CC BY 4.0).
        {data.present.fleet && " Weigh station and truck service points: DailyFuel, CC BY 4.0."}
        {data.present.roads && " Roads: NTAD National Highway Freight Network, U.S. DOT BTS, public domain."}
        {data.present.states && " State outlines: U.S. Census Bureau, public domain."}
        {data.present.places && <> Place names: <a href="https://www.geonames.org">GeoNames</a>, CC BY 4.0.</>}
        {" "}Drawn with Leaflet.
      </p>
    </section>
  </div>
  <script is:inline type="application/json" id="mapcfg" set:html={jsonBlock(cfg)} />

  <Fragment slot="scripts">
    <script is:inline defer src="/vendor/leaflet/leaflet.js"></script>
    <script is:inline type="module" set:html={mapScript()}></script>
  </Fragment>
</Base>

<style is:global>
  .top .btn[aria-current="page"] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  @media (forced-colors: active) {
    .top .btn[aria-current="page"] {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
    }
  }
  .mp-head {
    padding: 18px 0 2px;
  }
  .mp-h {
    margin: 0 0 4px;
    font-size: var(--fs-b);
    font-weight: 700;
  }
  .mp-in {
    margin: 0;
  }
  .fd {
    max-width: 520px;
    margin-top: 12px;
  }
  .fd fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .fd .rt-f {
    flex: 1 1 100%;
    max-width: none;
  }
  .fd .btn {
    flex: 1 1 auto;
  }
  .mp-tip {
    display: none;
    margin: 8px 0 0;
    color: var(--ink);
  }
  @media (pointer: coarse) {
    .mp-tip {
      display: block;
    }
  }
  .mp-mc {
    min-width: 0;
  }
  .mp-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 290px);
    gap: 16px 28px;
    align-items: start;
    margin-top: 12px;
  }
  .mp-map {
    position: relative;
    z-index: 0;
    height: 360px;
    height: min(360px, 50vh);
    height: min(360px, 50svh);
    border: 1px solid var(--edge);
    background: var(--bg);
  }
  @media (min-width: 600px) {
    .mp-map {
      height: 460px;
    }
  }
  /* a phone on its side: the map never fills the screen, so a thumb can always scroll past it */
  @media (max-height: 500px) and (orientation: landscape) {
    .mp-map {
      height: calc(100vh - 120px);
      height: calc(100svh - 120px);
      min-height: 220px;
    }
  }
  @media (min-width: 900px) {
    .mp-map {
      height: 600px;
    }
  }
  @media (max-width: 899px) {
    .mp-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .mp-msg {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 16px;
    text-align: center;
    font-size: var(--fs-s);
    color: var(--ink2);
  }
  /* with JS off the box is only its one line, not an empty map */
  @media (scripting: none) {
    .mp-map {
      height: auto;
    }
    .mp-msg {
      position: static;
    }
  }
  .mp-lg .sh {
    margin-top: 0;
  }
  .mp-lg .fine {
    margin: 10px 0 0;
  }
  .mp-attr {
    margin: 8px 0 0;
  }

  /* the legend: a tick, the marker's key, the name, the count */
  .lg {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .lg .lbl {
    margin: 8px 0 2px;
  }
  .lg-i {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 28px;
    font-size: var(--fs-t);
    cursor: pointer;
  }
  .lg-i input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--ink);
  }
  /* with JS off there is nothing to tick */
  .lg-i input:disabled {
    visibility: hidden;
  }
  .lg-i .n {
    margin-left: auto;
    color: var(--ink2);
  }
  .key {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font: 700 10px/1 var(--font);
    forced-color-adjust: none;
  }
  .key.kw {
    width: 12px;
    height: 12px;
    margin: 2px;
    border: 1.5px solid var(--ink);
    background: var(--bg);
  }
  .key.kv {
    width: 9px;
    height: 9px;
    margin: 3.5px;
    border-radius: 0;
    background: var(--ink2);
  }

  /* Leaflet in the paper terminal: paper, ink, hairlines, no shadows, no tip */
  .mp .leaflet-container {
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-t);
  }
  .mp .leaflet-container a {
    color: inherit;
  }
  .mp .leaflet-container:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .mp .leaflet-bar {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .mp .leaflet-bar a,
  .mp .leaflet-bar a:first-child,
  .mp .leaflet-bar a:last-child {
    width: 30px;
    height: 30px;
    border: 1px solid var(--edge);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    font: 700 16px/28px var(--font);
  }
  .mp .leaflet-bar a + a {
    border-top: 0;
  }
  .mp .leaflet-bar a:hover {
    background: var(--mark);
  }
  .mp .leaflet-bar a.leaflet-disabled {
    background: var(--bg);
    color: var(--edge);
  }
  .mp .leaflet-bar a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 0;
  }
  /* the base map in grey, colour on the page being only for a price change, and inverted for a true inverse dark mode */
  .mp .leaflet-tile-pane {
    filter: grayscale(1);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .mp .leaflet-tile-pane {
      filter: grayscale(1) invert(1);
    }
  }
  :root[data-theme="dark"] .mp .leaflet-tile-pane {
    filter: grayscale(1) invert(1);
  }
  @media (forced-colors: active) {
    .mp .leaflet-tile-pane {
      opacity: 0.4;
    }
  }
  /* the freight network over it, darker than the base map's roads */
  .mp path.ro {
    stroke: var(--ink);
    stroke-opacity: 0.3;
    stroke-width: 1.5;
  }
  .mp path.ri {
    stroke: var(--ink);
    stroke-opacity: 0.5;
    stroke-width: 2;
  }
  /* past zoom 10 the freight lines, good to about a kilometre, would drift off the base map's roads */
  #map:is([data-z="11"], [data-z="12"], [data-z="13"], [data-z="14"], [data-z="15"], [data-z="16"]) :is(path.ro, path.ri) {
    display: none;
  }
  /* a route's number: interstates boxed in ink from zoom 6, US routes from 7, the rest from 8, the others in a hairline (the script sets data-z) */
  .mp .hl {
    display: none;
    translate: -50% -50%;
    padding: 0 3px;
    border: 1px solid var(--hair);
    background: var(--bg);
    color: var(--ink2);
    font: 10px/14px var(--font);
    white-space: nowrap;
  }
  .mp .hl.h1 {
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 700;
  }
  #map:is([data-z="6"], [data-z="7"]) .hl.h1,
  #map[data-z="7"] .hl.h2,
  #map:is([data-z="8"], [data-z="9"], [data-z="10"]) .hl {
    display: block;
  }
  /* a road's name on hover or tap: paper and a hairline, no shadow, no tip */
  .mp .leaflet-tooltip {
    padding: 2px 6px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    box-shadow: none;
    font: var(--fs-s) / 1.4 var(--font);
  }
  .mp .leaflet-tooltip::before {
    display: none;
  }
  .mp path.rb {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    fill: var(--ink);
    fill-opacity: 0.05;
  }
  .mp path.rl {
    stroke: var(--ink);
    stroke-width: 2;
    fill: none;
  }
  .mp .rab {
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--bg);
    font: 700 12px/1 var(--font);
  }
  .mp .leaflet-popup {
    margin-bottom: 16px;
  }
  .mp .leaflet-popup-content-wrapper {
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
    box-shadow: none;
  }
  .mp .leaflet-popup-content {
    min-width: 180px;
    margin: 10px 12px;
    font-size: var(--fs-t);
    line-height: 1.45;
  }
  .mp .leaflet-popup-content p {
    margin: 0 0 3px;
  }
  .mp .leaflet-popup-content a {
    display: inline-block;
    min-height: 24px;
    line-height: 24px;
  }
  .mp .leaflet-popup-tip-container {
    display: none;
  }
  .pp-in:focus {
    outline: none;
  }
  .pp-in:focus-visible {
    outline: 2px solid var(--ink);
  }
  .pp-s {
    font-size: var(--fs-s);
    color: var(--ink2);
  }
  .pp-in .btn {
    margin-top: 6px;
  }

  /* the route strip */
  .rt fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .rt-f {
    display: inline-flex;
    flex: 1 1 200px;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: 320px;
    min-height: 30px;
    padding: 1px 8px;
    border: 1px solid var(--edge);
  }
  .rt-f span {
    font-weight: 700;
  }
  .rt-f input {
    flex: 1;
    width: 0;
    min-width: 0;
    padding: 3px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--fs-t);
  }
  .rt-f:focus-within {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
  }
  .rt-f input:focus {
    outline: none;
  }
  .rt-f input::-webkit-calendar-picker-indicator {
    display: none !important;
  }
  .rt .btn {
    min-height: 30px;
  }
  .rt fieldset:disabled .btn,
  .rt fieldset:disabled .rt-f {
    opacity: 0.5;
  }
  .mp-rt .note {
    margin-top: 12px;
  }
  .rt-st:empty {
    display: none;
  }
  .rsum {
    margin: 14px 0 0;
  }
  /* the trip's prices, one state a line, then each state's places folded */
  .rp {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .rp li {
    padding: 4px 0;
    border-bottom: 1px solid var(--hair);
  }
  .rs {
    margin-top: 10px;
  }
  .rs > summary {
    list-style: none;
  }
  .rs > summary::-webkit-details-marker {
    display: none;
  }
  .rs summary {
    min-height: 24px;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .rs table {
    width: auto;
    min-width: 0;
  }
  .rs td:nth-child(2) {
    min-width: 14ch;
    white-space: normal;
  }

  /* the key and its filters, behind one button on a phone */
  .lgt-l,
  #lgt {
    display: none;
  }
  #lgt:focus-visible + .lgt-l {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  #lgt:checked + .lgt-l .o1,
  #lgt:not(:checked) + .lgt-l .o2 {
    display: none;
  }
  .mp-cr p {
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .mp .leaflet-zoom-anim .leaflet-zoom-animated,
    .mp .leaflet-fade-anim .leaflet-popup {
      transition: none !important;
    }
  }
  /* the list starts closed: 2,400 rows cost a phone too much to lay out before anyone asks for them */
  #ls-d summary {
    display: inline-block;
    list-style: none;
  }
  #ls-d summary::-webkit-details-marker {
    display: none;
  }
  #ls-d[open] summary {
    margin-bottom: 8px;
  }
  #ls-d[open] .ls-o,
  #ls-d:not([open]) .ls-c {
    display: none;
  }

  /* the list: a box of its own, the heads stay put while it scrolls */
  .mlist {
    max-height: 480px;
    overflow: auto;
  }
  .mlist thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--bg);
  }
  .mlist td:first-child {
    white-space: normal;
    min-width: 16ch;
  }
  .lk {
    min-height: 24px;
    padding: 2px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--edge);
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .lk:hover {
