---
// A price the pump way: $6.28 with a raised 5. Screen readers get "$6.285".
import { priceParts } from "../lib/format.ts";
interface Props {
  price: number;
  class?: string;
  /** Wrap digits for the hero roll. */
  roll?: boolean;
  /** Say "per gallon" to screen readers. */
  perGallon?: boolean;
}
const { price, class: cls, roll = false, perGallon = false } = Astro.props;
const p = priceParts(price);
const digits = (s: string) => [...s];
---
<span class:list={["price", cls]}>
  <span class="sr-only">{p.plain}{perGallon ? " per gallon" : ""}</span>
  {roll ? (
    <span aria-hidden="true" data-roll>{digits(p.main).map((ch) => (/\d/.test(ch) ? <span class="dg">{ch}</span> : ch))}<span class="tenth"><span class="dg">{p.tenth}</span></span></span>
  ) : (
    <span aria-hidden="true">{p.main}<span class="tenth">{p.tenth}</span></span>
  )}
</span>
