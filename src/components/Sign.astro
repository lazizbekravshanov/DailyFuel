---
// The one loud thing on the page: a highway guide sign with the price on it.
// The change sits on a white inset plaque, like a route shield on a guide sign,
// so the direction colors keep their contrast.
import Price from "./Price.astro";
import Change from "./Change.astro";
import Icon from "./Icon.astro";
import type { Cadence } from "../lib/bins.ts";
interface Props {
  legend: string;
  price: number | null;
  noPrice?: string;
  change: number | null;
  pct?: number | null;
  prev?: number | null;
  cadence: Cadence;
  dateLine: string;
  compareLine?: string | null;
  roll?: boolean;
  shield?: string;
  /** Set when a note slot is passed, since Astro counts conditional slots as present. */
  note?: boolean;
  /** Small plate under the price saying whose average it is: "EIA Midwest average, 15 states". */
  plate?: string | null;
}
const { legend, price, noPrice = "No price", change, pct = null, prev = null, cadence, dateLine, compareLine = null, roll = false, shield, note = false, plate = null } = Astro.props;
---
<div class="sign">
  <div class="sign-legend-row">
    {shield && <span class="shield" aria-hidden="true">{shield}</span>}
    <h1 class="sign-legend">{legend}</h1>
  </div>
  <div class="sign-body">
    <div class="sign-price-block">
      {price !== null ? (
        <p class="sign-price"><Price price={price} roll={roll} perGallon /></p>
      ) : (
        <p class="sign-price sign-price-none">{noPrice}</p>
      )}
      {price !== null && plate && <p class="sign-plate"><Icon name="region" size={16} />{plate}</p>}
      <p class="sign-date">{dateLine}</p>
    </div>
    {price !== null && (
      <div class="sign-change-block">
        <p class="plaque"><Change change={change} pct={pct} prev={prev} cadence={cadence} empty="No earlier price yet" /></p>
        {compareLine && <p class="sign-date">{compareLine}</p>}
      </div>
    )}
  </div>
  {note && <div class="sign-note"><slot name="note" /></div>}
</div>

<style>
  .sign {
    --plaque-ink: #1d2125;
    position: relative;
    background: var(--sign);
    color: var(--sign-ink);
    border-radius: var(--radius-sign);
    box-shadow:
      inset 0 0 0 6px var(--sign),
      inset 0 0 0 9px var(--sign-ink);
    padding: 26px 28px 24px;
    font-weight: 700;
    container-type: inline-size;
    letter-spacing: 0.01em;
  }

  .sign p {
    margin: 0;
    max-width: none;
  }

  .sign-legend-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sign-legend {
    font-size: var(--fs-h2);
    font-weight: 750;
    letter-spacing: 0.015em;
    line-height: 1.15;
  }

  .shield {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: 2.4em;
    height: 1.7em;
    padding: 0.1em 0.4em 0;
    background: var(--sign-ink);
    color: var(--sign);
    border-radius: 6px;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .sign-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: 14px;
  }

  .sign-price {
    font-size: var(--fs-sign-price);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.005em;
    padding-top: 0.12em;
    font-variant-numeric: proportional-nums;
  }

  /* the raised tenth sits level with the cap tops, like a pump board */
  .sign-price :global(.tenth) {
    font-size: 0.5em;
    top: -0.72em;
    margin-left: 0.04em;
  }

  /* From a 1024 laptop up, the price and the plaque share one row once the
     price gives up a little size. On a wide state sign that's 112px to 106px,
     which keeps a double digit percent like "(+10.1%)" on one line. */
  @container (min-width: 460px) {
    .sign-body {
      column-gap: 16px;
    }
    .sign-price:not(.sign-price-none) {
      font-size: min(17.5cqi, 112px);
    }
  }

  /* A supplemental plate under the main legend, the way a guide sign carries a
     smaller panel: white outline, white type, same green. */
  .sign .sign-plate {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 14px 0 8px;
    padding: 4px 9px 2px;
    border: 2px solid var(--sign-ink);
    border-radius: 6px;
    font-size: clamp(14px, 2.4cqi, 16px);
    font-weight: 650;
    line-height: 1.3;
  }
  /* icons on the sign wear the sign's white, not the paper's gray */
  .sign :global(.icon) {
    color: inherit;
  }

  .sign-price-none {
    font-size: clamp(34px, 7vw, 56px);
    padding-top: 0.2em;
  }

  .sign-date {
    margin-top: 10px;
    font-size: 19px;
    font-weight: 650;
    line-height: 1.2;
  }

  .sign-change-block {
    text-align: left;
    /* lets the plaque wrap its own text under WCAG text spacing instead of
       pushing past the sign's border */
    min-width: 0;
  }
  @container (min-width: 600px) {
    .sign-body {
      flex-wrap: nowrap;
      column-gap: 16px;
    }
    .sign-change-block {
      padding-bottom: 2px;
    }
  }

  .plaque {
    display: inline-block;
    background: var(--sign-ink);
    color: var(--plaque-ink);
    border-radius: 7px;
    padding: 7px 14px 4px;
    font-size: clamp(22px, 4.6cqi, 30px);
    font-weight: 750;
    line-height: 1.2;
    --glyph-up: #c94d47;
    --glyph-down: #3a75bf;
    --glyph-flat: #51565b;
  }

  .plaque :global(.change) {
    white-space: normal;
  }

  .plaque :global(.muted) {
    color: #51565b;
    font-size: 0.7em;
  }

  .sign-note {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 2px solid rgb(255 255 255 / 0.35);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (max-width: 639px) {
    .sign {
      padding: 22px 22px 20px;
      border-radius: 12px;
      box-shadow:
        inset 0 0 0 5px var(--sign),
        inset 0 0 0 8px var(--sign-ink);
    }
    .sign-legend {
      font-size: 22px;
    }
    .sign-date {
      font-size: 17px;
    }
    .shield {
      font-size: 16px;
    }
  }

  @media (forced-colors: active) {
    .sign {
      border: 3px solid CanvasText;
    }
    /* The price's inline box overhangs its block box, and forced colors paints
       an opaque backplate behind the text, which then covers the date under it.
       Only the date under the price needs the clearance. */
    .sign-price-block .sign-date {
      margin-top: 16px;
    }
    /* Forced colors repaints the transparent digit under a rolling reel, so
       the roll would show every digit twice. Keep the plain price instead. */
    .sign .sign-price :global(.dg .reel) {
      display: none;
    }
  }
</style>
