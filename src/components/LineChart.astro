---
// A line chart with one y axis, hairline grid, 2px lines, and a direct label at
// the end of each line. Observable Plot draws the grid and lines at build time
// (src/lib/plotting.ts), so the page gets plain SVG and no chart library.
// Hover or keyboard focus shows a crosshair and tooltip (src/scripts/chart.js).
import Price from "./Price.astro";
import { chartLabel, type ChartModel } from "../lib/chart.ts";
import { linesSvg } from "../lib/plotting.ts";
import { EDGES } from "../lib/bins.ts";
interface Props {
  model: ChartModel;
  height: number;
  /** Full accessible name. Leave it out to build one with chartLabel from `title`. */
  label?: string;
  /** What and over what stretch, for the built name: "Midwest weekly diesel price, last 52 weeks". */
  title?: string;
  /** Where the numbers are, for the built name: "Every week is in the table below." */
  tableNote?: string;
  weekly: boolean;
  compact?: boolean;
  class?: string;
}
const { model, height, label, title, tableNote, weekly, compact = false, class: cls } = Astro.props;
const primary = model.paths.find((p) => p.kind === "primary") ?? model.paths[0];
const name = label ?? chartLabel({ name: title ?? primary?.label ?? "Price", points: primary?.points ?? [], weekly, tableNote });
const svg = linesSvg({
  from: model.from,
  to: model.to,
  lo: model.yDomain.lo,
  hi: model.yDomain.hi,
  grid: model.grid,
  lines: model.paths.map((p) => ({ kind: p.kind, step: p.step, points: p.points })),
});
// The tooltip's change row uses the same about the same line as the map bins.
const flat = EDGES[weekly ? "weekly" : "daily"][0];
const hover = JSON.stringify({ weekly, flat, prev: model.hover.prev, dates: model.hover.dates, x: model.hover.x, series: model.hover.series });
---
<div class:list={["chart", compact && "chart-compact", cls]} style={`--h:${height}px`}>
  <div class="chart-plot" tabindex="0" role="img" aria-label={name} data-chart={hover}>
    <div class="y-axis" aria-hidden="true">
      {model.yTicks.map((t) => <span style={`top:${t.pos}%`}>{t.label}</span>)}
    </div>
    <div class="plot-area">
      <Fragment set:html={svg} />
      {model.ends.map((e) => <span class={`end-dot end-dot-${e.kind}`} style={`left:${e.x}%;top:${e.y}%`} aria-hidden="true"></span>)}
    </div>
    <div class="end-labels" aria-hidden="true">
      {model.showEndLabels && model.ends.map((e) => <span class={`end-${e.kind}`} style={`top:${e.y}%`}><Price price={e.value} /></span>)}
    </div>
    <div class="x-axis" aria-hidden="true">
      {model.xTicks.map((t) => <span class:list={[t.minor && "minor", t.thin && "thin", t.anchor === "start" && "start"]} style={`left:${t.pos}%`}>{t.label}</span>)}
    </div>
  </div>
</div>

<style>
  /* The top padding keeps the focus ring clear of the top y label, which
     sits half above the plot. */
  .chart-plot {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 66px;
    grid-template-rows: var(--h) auto;
    padding-top: 8px;
    border-radius: 4px;
  }
  /* small multiples: a card can hand its y label column to the plot */
  .chart-compact .chart-plot {
    grid-template-columns: var(--y-axis-w, 34px) minmax(0, 1fr) 58px;
  }
  .chart-plot:focus-visible {
    outline-offset: 4px;
  }
  .y-axis {
    position: relative;
    grid-column: 1;
    grid-row: 1;
  }
  .y-axis span,
  .x-axis span,
  .end-labels span {
    position: absolute;
    white-space: nowrap;
    line-height: 1;
  }
  .y-axis span {
    right: 8px;
    transform: translateY(-45%);
    font-size: 13px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .plot-area {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    touch-action: pan-y;
  }
  .plot-area :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .plot-area :global(.grid) {
    stroke: var(--hairline);
    stroke-width: 1;
  }
  .plot-area :global(.grid line) {
    vector-effect: non-scaling-stroke;
    shape-rendering: crispEdges;
  }
  .plot-area :global(.line) {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .plot-area :global(.line path) {
    vector-effect: non-scaling-stroke;
  }
  .plot-area :global(.line-primary) {
    stroke: var(--line-primary);
  }
  .plot-area :global(.line-bench) {
    stroke: var(--line-bench);
  }
  .end-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--paper);
  }
  .end-dot-primary {
    background: var(--line-primary);
  }
  .end-dot-bench {
    background: var(--line-bench);
  }
  .end-labels {
    position: relative;
    grid-column: 3;
    grid-row: 1;
  }
  .end-labels span {
    left: 10px;
    transform: translateY(-45%);
    font-size: 15px;
    font-weight: 700;
  }
  .end-labels .end-bench {
    color: var(--ink-2);
    font-weight: 600;
  }
  .x-axis {
    position: relative;
    grid-column: 2;
    grid-row: 2;
    height: 26px;
  }
  .x-axis span {
    top: 9px;
    transform: translateX(-50%);
    font-size: 13px;
    color: var(--ink-2);
  }
  /* a month name that starts on the first of its month */
  .x-axis .start {
    transform: none;
  }
  @media (max-width: 639px) {
    .x-axis .minor {
      display: none;
    }
  }
  @media (max-width: 359px) {
    .x-axis .thin {
      display: none;
    }
  }
  .chart-compact .end-labels span {
    font-size: 14px;
  }
  .chart-compact .y-axis span {
    font-size: 12px;
  }
  .chart-compact .x-axis span {
    top: 8px;
    font-size: 12px;
  }

  .plot-area :global(.cross) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--ink-2);
    pointer-events: none;
  }
  .plot-area :global(.cross-dot) {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--paper);
    pointer-events: none;
  }
  .plot-area :global(.cross-dot-primary) {
    background: var(--line-primary);
  }
  .plot-area :global(.cross-dot-bench) {
    background: var(--line-bench);
  }
  .plot-area :global(.chart-tip) {
    position: absolute;
    top: 0;
    z-index: 4;
    padding: 8px 10px 6px;
    background: var(--paper);
    border: 1px solid var(--hairline-strong);
    border-radius: 6px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
    font-size: 14px;
    line-height: 1.35;
    white-space: nowrap;
    pointer-events: none;
  }
  .plot-area :global(.tip-date) {
    color: var(--ink-2);
    margin-bottom: 2px;
  }
  .plot-area :global(.tip-row) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .plot-area :global(.tip-row strong) {
    font-size: 16px;
  }
  .plot-area :global(.tip-label) {
    color: var(--ink-2);
  }
  .plot-area :global(.tip-key) {
    width: 14px;
    height: 2px;
    flex: none;
  }
  .plot-area :global(.tip-key-primary) {
    background: var(--line-primary);
  }
  .plot-area :global(.tip-key-bench) {
    background: var(--line-bench);
  }
  /* the week's move under the price: glyph in its color, numbers in ink */
  .plot-area :global(.tip-change) {
    gap: 0;
    padding-left: 22px;
  }
  /* direction glyph drawn in CSS, the same shapes as Glyph.astro */
  .plot-area :global(.tg) {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.35em;
  }
  .plot-area :global(.tg-up) {
    background: var(--glyph-up);
    clip-path: polygon(50% 8%, 98% 92%, 2% 92%);
  }
  .plot-area :global(.tg-down) {
    background: var(--glyph-down);
    clip-path: polygon(2% 8%, 98% 8%, 50% 92%);
  }
  .plot-area :global(.tg-flat) {
    background: var(--glyph-flat);
    clip-path: circle(36%);
  }

  /* Windows contrast themes drop span backgrounds. The dots, the crosshair and
     the tooltip key are data marks, so they keep a color the theme picks. */
  @media (forced-colors: active) {
    .end-dot,
    .plot-area :global(.cross),
    .plot-area :global(.cross-dot),
    .plot-area :global(.tip-key),
    .plot-area :global(.tg) {
      forced-color-adjust: none;
      background: CanvasText;
      box-shadow: none;
    }
    /* The state page range switch marks its checked choice with a fill the
       theme would erase, so both choices would look the same. Keep the fill. */
    :global(.range-switch .range input:checked + label) {
      forced-color-adjust: none;
    }
  }
</style>
