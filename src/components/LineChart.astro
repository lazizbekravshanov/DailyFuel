---
// A price line on the paper terminal: a 1.5px ink line over a hairline grid,
// the newest price tagged on the axis in inverse, and a readout above the plot
// that the pointer and the arrow keys both drive (src/scripts/chart.js).
// Observable Plot draws the line at build time (src/lib/plotting.ts), so the
// page gets plain SVG and no chart library. The axis labels are text beside
// the SVG, so they never stretch with it. The readout script takes its dates
// and prices from the NumbersTable under the chart, so the plot box carries
// only its window.
import { chartLabel, yLabels, type ChartModel } from "../lib/chart.ts";
import { formatDate } from "../lib/dates.ts";
import { changeClass, formatPrice, formatQuote, formatSignedCents, toUnits } from "../lib/format.ts";
import { linesSvg } from "../lib/plotting.ts";
interface Props {
  model: ChartModel;
  /** Plot height in px, and the height under 760px. */
  height?: number;
  mobileHeight?: number;
  /** Full accessible name. Leave it out to build one with chartLabel from `title`. */
  label?: string;
  /** What and over what stretch, for the built name: "Midwest weekly diesel price, last 52 weeks". */
  title?: string;
  /** Where the numbers are, for the built name: "Every week is in the table below." */
  tableNote?: string;
  weekly: boolean;
  class?: string;
}
const { model, height = 220, mobileHeight = 160, label, title, tableNote, weekly, class: cls } = Astro.props;
const primary = model.paths.find((p) => p.kind === "primary") ?? model.paths[0];
const name = label ?? chartLabel({ name: title ?? primary?.label ?? "Price", points: primary?.points ?? [], weekly, tableNote });
const end = model.ends.find((e) => e.kind === "primary") ?? model.ends[0] ?? null;
const svg = linesSvg({
  from: model.from,
  to: model.to,
  lo: model.yDomain.lo,
  hi: model.yDomain.hi,
  grid: model.grid,
  lines: model.paths.map((p) => ({ kind: p.kind, step: p.step, points: p.points })),
  dot: end ? { x: end.x, y: end.y } : null,
});
// The readout starts on the newest point that has a price, with its move
// from the point before, the way the script will print it.
const values = model.hover.series[0]?.values ?? [];
let last = values.length - 1;
while (last > 0 && values[last] === null) last -= 1;
const nowValue = last >= 0 ? values[last] : null;
let before: number | null = null;
for (let k = last - 1; k >= 0 && before === null; k--) before = values[k];
if (before === null && model.hover.prev) before = model.hover.prev[1];
const change = nowValue !== null && before !== null ? (toUnits(nowValue) - toUnits(before)) / 10000 : null;
const bench = model.hover.series[1] ?? null;
const benchNow = bench && last >= 0 && bench.values[last] !== null ? `${bench.label} ${formatPrice(bench.values[last]!)}` : null;
const unit = weekly ? "week" : "day";
---
<figure class:list={["chart", cls]} style={`--h:${height}px;--hm:${mobileHeight}px`}>
  <p class="rdout" aria-live="polite">
    <span class="rd-d">{last >= 0 && formatDate(model.hover.dates[last])}</span>{" "}
    <b class="rd-v">{nowValue !== null ? formatPrice(nowValue) : "No price"}</b>{" "}
    <span class:list={["rd-c", change !== null && changeClass(change)]}>{change !== null && formatSignedCents(change)}</span>{" "}
    {bench && <span class="rd-b muted">{benchNow}</span>}{" "}
    <span class="rd-h muted">Point at the line, or press the arrow keys, to read a {unit}.</span>
  </p>
  <div class="plot" tabindex="0" role="img" aria-label={name} data-from={model.from} data-to={model.to}>
    <div class="pa">
      <Fragment set:html={svg} />
      <span class="cross" hidden></span>
      {yLabels(model).map((t) => <span class="yl" style={`top:${t.pos}%`}>{formatQuote(t.value)}</span>)}
      {end && <b class="ytag" style={`top:${end.y}%`}>{formatQuote(end.value)}</b>}
      {model.xTicks.map((t) => <span class:list={["xl", t.anchor === "start" && "first"]} style={`left:${t.pos}%`}>{t.label}</span>)}
    </div>
  </div>
</figure>

<style is:global>
  /* a finger can still scroll the page over the plot */
  .pa {
    touch-action: pan-y;
  }
  /* the benchmark line under a daily one, in the secondary ink */
  .pa path.bench {
    stroke: var(--ink2);
  }
  .rd-b {
    padding-left: 4px;
  }
</style>
