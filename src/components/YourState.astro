---
// Your state, first on the home page. It is empty in the HTML; the inline
// script right after it (src/scripts/your-state.ts) reads the saved state,
// fills the answer from the JSON block and marks the section with
// data-ys-state, before anything under it is parsed, so nothing moves. With
// nothing saved, JS off or storage blocked, the section shows nothing and the
// U.S. average leads, with the picker under it. On a phone the saved state's
// price is the headline; on a wide screen the answer is one boxed line.
import { inlineCall } from "../lib/inline.ts";
import { getSite } from "../lib/site.ts";
import { yourStateJson } from "../lib/yourstate.ts";
import { yourState } from "../scripts/your-state.ts";

const site = getSite();
// JSON for a <script type="application/json"> block: nothing in it can close the tag
const data = JSON.stringify(yourStateJson(site)).replace(/</g, "\\u003c");
// Reaching localStorage can throw by itself, so the script asks for it inside its own try.
const wire = inlineCall(yourState, "document", "function(){return window.localStorage}");
---
<section class="ys" aria-label="Your state" data-ys>
  <div class="ans">
    <p class="lbl"><span data-f="n"></span> diesel</p>
    <p class="big"><span data-f="p"></span></p>
    <p class="chw"><b data-f="c"></b> <span data-f="f"></span></p>
    <p class="pl" data-f="l"></p>
    {/* the week line the page prints under the U.S. price, passed in */}
    <p class="wkl"><slot /></p>
    <p class="op"><a class="btn wide" href="/#find-your-state" data-ys-open>Open the <span data-f="n"></span> page</a></p>
  </div>
  <script is:inline type="application/json" id="ys-data" set:html={data}></script>
  <script is:inline set:html={wire}></script>
</section>
