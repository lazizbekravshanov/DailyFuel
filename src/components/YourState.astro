---
// The your state strip under the U.S. average: one boxed line with the saved
// state's code, name, price, change and where the number comes from, and the
// OPEN, CHANGE and FORGET controls. The server renders "Nothing saved yet"
// with the Find your state list under it, which is what anyone sees with no
// saved state, with JS off, or when storage is blocked. When a state was saved
// before (a state page was opened, or one was picked from the list), the
// inline script right after the list (src/scripts/your-state.ts) fills the
// hidden saved strip from that state's link in the list and swaps it in, and
// CSS keeps the list out of the way. Both strips are one line tall, so the
// page under them never moves. The same script wires CHANGE and FORGET.
import FindYourState from "./FindYourState.astro";
import { inlineCall } from "../lib/inline.ts";
import { yourState } from "../scripts/your-state.ts";

// Reaching localStorage can throw by itself, so the script asks for it inside its own try.
const wire = inlineCall(yourState, "document", "function(){return window.localStorage}", "location.hash");
---
<section class="ys" aria-label="Your state" data-ys>
  <div class="strip" data-ys-saved hidden>
    <p class="lbl">Your state</p>
    <span class="sym" data-ys-code></span>
    <span class="nm" data-ys-name></span>
    <span class="px" data-ys-price></span>
    <span class="ch muted" data-ys-move></span>
    <span class="muted pl" data-ys-plate></span>
    <span class="acts">
      <a class="btn" href="/#find-your-state" data-ys-open>Open</a>
      <button type="button" class="btn" data-ys-change aria-controls="find-your-state" aria-expanded="false">Change</button>
      <button type="button" class="btn" data-ys-forget>Forget</button>
    </span>
  </div>
  <div class="strip" data-ys-none>
    <p class="lbl">Your state</p>
    <span class="muted">Nothing saved yet. Open any state, or pick one from the list, and it stays on this phone.</span>
  </div>
  <FindYourState strip />
  <script is:inline set:html={wire}></script>
</section>

<style is:global>
  /* both strips stand the same 44px tall on one line, so a saved state and
     "nothing saved" take the same room and nothing below them moves */
  .ys .strip {
    min-height: 44px;
  }
  /* a saved state takes the row; the list shows under it only when asked for */
  .ys[data-ys-state]:not([data-ys-list]) .pick {
    display: none;
  }
  @media (max-width: 479px) {
    .ys .acts {
      margin-left: 0;
    }
  }
</style>
