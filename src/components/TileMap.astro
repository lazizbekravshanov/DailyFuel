---
// Phone map: one square per state on a grid, placed from states.json tile row and col.
// Each tile carries its direction arrow, so up and down never rest on hue alone.
// While EIA is the source, a heavier line runs between tiles in different
// price regions. The grid itself never moves.
import Glyph from "./Glyph.astro";
import { mapLabel } from "../lib/copy.ts";
import type { SiteData } from "../lib/site.ts";
import { regionNote, withNote } from "./home/home.ts";
interface Props {
  site: SiteData;
  label: string;
}
const { site, label } = Astro.props;
const cols = Math.max(...site.states.map((s) => s.tile.col)) + 1;
const rows = Math.max(...site.states.map((s) => s.tile.row)) + 1;
const regionsOn = site.mode === "eia_only";
const members = new Map(site.regions.map((r) => [r.key as string, r.states]));
const at = new Map(site.states.map((s) => [`${s.tile.row},${s.tile.col}`, s]));
// A region border runs between two tiles side by side (or one above the other)
// whose regions differ. Each border is drawn once, from the tile left of it or above it.
const differs = (a: string | null, b: string | null | undefined) => b !== undefined && a !== null && b !== null && a !== b;
---
<nav class:list={["tiles", { "regions-on": regionsOn }]} aria-label={label} style={`--cols:${cols};--rows:${rows}`}>
  {site.states.map((s) => {
    const l = mapLabel(s, site);
    const region = regionsOn ? s.eia_series : null;
    const note = region && s.regionName ? regionNote(s.regionName, members.get(region) ?? [s.code]) : l.note;
    const right = at.get(`${s.tile.row},${s.tile.col + 1}`);
    const below = at.get(`${s.tile.row + 1},${s.tile.col}`);
    const edgeR = regionsOn && differs(s.eia_series, right ? right.eia_series : undefined);
    const edgeB = regionsOn && differs(s.eia_series, below ? below.eia_series : undefined);
    // A line runs on across a corner gap only when there are tiles past that
    // corner, so no stub pokes out past the edge of the map.
    const has = (r: number, c: number) => at.has(`${r},${c}`);
    const { row: r, col: c } = s.tile;
    const ends = [
      edgeR && !(has(r - 1, c) || has(r - 1, c + 1)) ? "--rt:0" : "",
      edgeR && !(has(r + 1, c) || has(r + 1, c + 1)) ? "--rb:0" : "",
      edgeB && !(has(r, c - 1) || has(r + 1, c - 1)) ? "--bl:0" : "",
      edgeB && !(has(r, c + 1) || has(r + 1, c + 1)) ? "--br:0" : "",
    ].filter(Boolean);
    // The visible label on a tile is the two letter code, so the accessible
    // name has to start with it (WCAG 2.5.3 Label in Name). Without it, voice
    // control users saying "click AK" can't activate the tile.
    return (
      <a
        class:list={["tile", `f-${s.fill}`, { "edge-r": edgeR, "edge-b": edgeB }]}
        href={s.href}
        aria-label={`${s.code}. ${withNote(l.aria, l.note, note)}`}
        style={[`grid-row:${r + 1}`, `grid-column:${c + 1}`, ...ends].join(";")}
      >
        <span class="code">{s.code}</span>
        {l.dir && <Glyph direction={l.dir} />}
      </a>
    );
  })}
</nav>

<style>
  .tiles {
    --gap: 3px;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), auto);
    gap: var(--gap);
    max-width: 520px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    aspect-ratio: 1;
    min-height: 26px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    line-height: 1;
    padding-top: 2px;
  }
  /* the arrow wears the tile's own text color, which clears 4.5:1 on every
     fill. Its 10px box holds an up or down arrow about as tall as the code's
     capitals, the size the old 8px triangle was. */
  .tile :global(.glyph) {
    width: 10px;
    height: 10px;
    margin: 0;
    fill: currentColor;
  }
  @media (max-width: 359px) {
    .tile :global(.glyph) {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .tile :global(.glyph) {
      fill: currentColor;
    }
  }
  /* region borders: a line that fills the gap, running on across the corner
     gaps so lines that meet there join up */
  .tile.edge-r::after,
  .tile.edge-b::before {
    content: "";
    position: absolute;
    z-index: 1;
    background: var(--ink-2);
    pointer-events: none;
  }
  .tile.edge-r::after {
    top: calc(var(--gap) * -1 * var(--rt, 1));
    bottom: calc(var(--gap) * -1 * var(--rb, 1));
    right: calc(var(--gap) * -1);
    width: var(--gap);
  }
  .tile.edge-b::before {
    left: calc(var(--gap) * -1 * var(--bl, 1));
    right: calc(var(--gap) * -1 * var(--br, 1));
    bottom: calc(var(--gap) * -1);
    height: var(--gap);
  }
  .tile:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
    z-index: 2;
  }
</style>
