---
// Choropleth of the latest change, drawn at build time. Each state is a link.
// While EIA is the source, states share their region's price, so the map also
// draws the 8 regions: wide paper lines where two regions meet and thin state
// lines inside them. On hover and focus the script lights the whole region.
import { CALLOUTS, MAP_HEIGHT, nationOutline, regionEdges, stateShape } from "../lib/geo.ts";
import { mapLabel } from "../lib/copy.ts";
import { priceParts } from "../lib/format.ts";
import type { SiteData } from "../lib/site.ts";
import { regionNote, withNote } from "./home/home.ts";
import { arrowPath } from "../lib/arrows.ts";
interface Props {
  site: SiteData;
  label: string;
}
const { site, label } = Astro.props;
const WIDTH = 1000;
// Callout chips for the small eastern states: about 34 by 24px with a 27px
// pitch on the 608px map at 1024, which clears the 24px target size.
const BOX_W = 56;
const BOX_H = 40;
const BOX_GAP = 4;
const BOX_X = 942;
const BOX_Y = 160;
// The direction arrow on a chip: the 24 unit icon in a 14.4 unit box, centered
// where the old 10 unit triangle sat. That makes an up or down arrow as wide as
// the triangle was (9.4 units) and a little shorter than the code's capitals.
const ARROW_SCALE = 0.6;
const ARROW_BOX = 24 * ARROW_SCALE;

const regionsOn = site.mode === "eia_only";
const members = new Map(site.regions.map((r) => [r.key as string, r.states]));
const byFips = new Map(site.states.map((s) => [s.fips, s]));
const edges = regionsOn ? regionEdges((fips) => byFips.get(fips)?.eia_series ?? null) : null;

const items = site.states.map((s) => {
  const l = mapLabel(s, site);
  // a region of one (California) lights up like any single state
  const region = regionsOn && s.eia_series && s.regionName && (members.get(s.eia_series)?.length ?? 0) > 1 ? s.eia_series : null;
  const note = regionsOn && s.eia_series && s.regionName ? regionNote(s.regionName, members.get(s.eia_series) ?? [s.code]) : l.note;
  const parts = s.primary ? priceParts(s.primary.price) : null;
  // The native tooltip, shown with JS off, says the price is shared too, the
  // way the aria label and the script's tooltip do.
  const title = regionsOn && s.eia_series && s.regionName ? `${l.title.replace(/\.$/, "")}. ${note}` : l.title;
  return {
    s,
    shape: stateShape(s.fips),
    l,
    region,
    note,
    title,
    aria: withNote(l.aria, l.note, note),
    main: parts?.main ?? "",
    tenth: parts?.tenth ?? "",
  };
});
const callouts = CALLOUTS.map((code, i) => ({
  item: items.find((it) => it.s.code === code)!,
  y: BOX_Y + i * (BOX_H + BOX_GAP),
}));
---
<div class="map-wrap" data-map>
  <svg class:list={["us-map", { "regions-on": regionsOn }]} viewBox={`0 0 ${WIDTH} ${MAP_HEIGHT}`} role="group" aria-label={label} tabindex="-1">
    <defs>
      <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect class="hatch-bg" width="7" height="7"></rect>
        <line class="hatch-line" x1="1.5" y1="0" x2="1.5" y2="7"></line>
      </pattern>
    </defs>
    <g class="states">
      {items.map(({ s, shape, l, region, note, title, aria, main, tenth }) => (
        <a
          class="state"
          href={s.href}
          aria-label={aria}
          data-code={s.code}
          data-name={s.name}
          data-region={region ?? undefined}
          data-price={l.price}
          data-main={main || undefined}
          data-tenth={tenth || undefined}
          data-change={l.change}
          data-dir={l.dir}
          data-note={note}
        >
          <title>{title}</title>
          <path class={`f f-${s.fill}`} d={shape.d}></path>
        </a>
      ))}
    </g>
    {edges && <path class="region-edges" d={edges} aria-hidden="true"></path>}
    <path class="nation" d={nationOutline()} aria-hidden="true"></path>
    <g class="callouts" aria-hidden="true">
      {callouts.map(({ item: { s, l, region, note, main, tenth }, y }) => {
        const cx = BOX_X + BOX_W / 2;
        return (
          <a
            class="callout"
            href={s.href}
            tabindex="-1"
            data-code={s.code}
            data-name={s.name}
            data-region={region ?? undefined}
            data-price={l.price}
            data-main={main || undefined}
            data-tenth={tenth || undefined}
            data-change={l.change}
            data-dir={l.dir}
            data-note={note}
          >
            <rect class={`f f-${s.fill}`} x={BOX_X} y={y} width={BOX_W} height={BOX_H} rx="5"></rect>
            {/* code on the left, direction arrow on the right, both in the fill's text color */}
            <text class={`t t-${s.fill}`} x={l.dir ? cx - 7 : cx} y={y + BOX_H / 2 + 6.5} text-anchor="middle">{s.code}</text>
            {l.dir && (
              <path
                class={`arrow t-${s.fill}`}
                d={arrowPath(l.dir)}
                transform={`translate(${cx + 16 - ARROW_BOX / 2} ${y + BOX_H / 2 - ARROW_BOX / 2}) scale(${ARROW_SCALE})`}
              ></path>
            )}
          </a>
        );
      })}
    </g>
    <g class="map-hi" aria-hidden="true">
      <g class="hi-rg-halo"></g>
      <g class="hi-rg-line"></g>
      <g class="hi-rg-cover"></g>
      <path class="hi-halo" d=""></path>
      <path class="hi-line" d=""></path>
      <path class="hi-state" d=""></path>
    </g>
  </svg>
  <div class="map-tip" hidden></div>
</div>

<style is:global>
  .map-wrap {
    position: relative;
  }
  .us-map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .us-map .state {
    outline: none;
  }
  .us-map .f {
    stroke: var(--paper);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  /* inside a region every state has the same price, so its lines go quiet */
  .us-map.regions-on .states .f {
    stroke-width: 0.5;
  }
  .us-map .state .f-nodata {
    stroke: var(--hairline-strong);
  }
  .us-map .region-edges {
    fill: none;
    stroke: var(--paper);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }
  .us-map .nation {
    fill: none;
    stroke: var(--hairline-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }
  .us-map .state:focus-visible .f {
    stroke: var(--focus);
    stroke-width: 3;
  }
  .us-map .callout {
    cursor: pointer;
  }
  .us-map .callout .f {
    stroke-width: 0;
  }
  .us-map .callout.is-active .f {
    stroke: var(--focus);
    stroke-width: 2.5;
  }
  /* Every chip in a lit region gets the ring above, so the one under the
     pointer or keyboard turns ink with paper lettering, like the dashed state
     line on the map. Its change is still in the tooltip. */
  .us-map .callout.is-current .f {
    fill: var(--focus);
    stroke: var(--focus);
    stroke-width: 2.5;
  }
  .us-map .callout.is-current .t,
  .us-map .callout.is-current .arrow {
    fill: var(--focus-halo);
  }
  @media (forced-colors: active) {
    .us-map .callout.is-current .f,
    .us-map .callout.is-current .t,
    .us-map .callout.is-current .arrow {
      forced-color-adjust: none;
    }
    .us-map .callout.is-current .f {
      fill: Highlight;
      stroke: CanvasText;
    }
    .us-map .callout.is-current .t,
    .us-map .callout.is-current .arrow {
      fill: HighlightText;
    }
  }
  .us-map .callout .t {
    font-family: var(--font);
    font-size: 19px;
    font-weight: 700;
    pointer-events: none;
  }
  .us-map .map-hi path {
    pointer-events: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .us-map .map-hi > path {
    fill: none;
  }
  /* A lit region: copies of its states, stroked wide in paper and then in ink,
     with filled copies on top. Only the outer half of the strokes shows, so the
     outline follows the region's edge and none of the lines inside it. */
  .us-map .hi-rg-halo path {
    fill: var(--focus-halo);
    stroke: var(--focus-halo);
    stroke-width: 9;
  }
  .us-map .hi-rg-line path {
    fill: var(--focus);
    stroke: var(--focus);
    stroke-width: 5;
  }
  .us-map .hi-rg-cover .f {
    stroke-width: 0.5;
  }
  .us-map .hi-halo {
    stroke: var(--focus-halo);
    stroke-width: 6;
  }
  .us-map .hi-line {
    stroke: var(--focus);
    stroke-width: 2.5;
  }
  /* the state under the pointer, inside its lit region */
  .us-map .hi-state {
    stroke: var(--focus);
    stroke-width: 2;
    stroke-dasharray: 4 3;
  }
  .map-tip {
    position: absolute;
    z-index: 5;
    min-width: 180px;
    max-width: 260px;
    padding: 10px 12px 8px;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--hairline-strong);
    border-radius: 6px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
    pointer-events: none;
    font-size: 15px;
    line-height: 1.35;
  }
  .map-tip .tip-name {
    color: var(--ink-2);
  }
  .map-tip .tip-price {
    font-size: 21px;
    font-weight: 750;
  }
  .map-tip .tip-price .tenth {
    font-size: 0.6em;
    top: -0.6em;
  }
  .map-tip .tip-unit {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .map-tip .tip-change {
    font-weight: 600;
  }
  .map-tip .tip-note {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 14px;
  }
</style>
