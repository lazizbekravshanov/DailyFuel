---
import staleScript from "../scripts/stale.js?raw";
import type { SiteData } from "../lib/site.ts";
import { formatShortDate } from "../lib/dates.ts";
// The style at the end is global, not scoped: the scope attributes cost bytes
// on every page, and the state pages have a budget.
interface Props {
  site: SiteData;
}
const { site } = Astro.props;
const aaa = site.mode === "aaa+eia" ? (site.latest.aaa?.as_of ?? "") : "";
const eia = site.latest.eia?.period ?? "";
// Says which week the page still shows, so nobody takes it for this week's.
const week = site.latest.eia ? ` These are still the prices for the week of ${formatShortDate(site.latest.eia.period)}.` : "";
---
<div class="wrap">
  <p id="stale-banner" class="stale" role="status" data-aaa={aaa} data-eia={eia} hidden>
    New prices are late.{week}
  </p>
</div>
<script is:inline set:html={staleScript}></script>

<style is:global>
  .stale {
    max-width: none;
    margin: 16px 0 0;
    padding: 9px 12px;
    border: 1px solid var(--ink);
    font-weight: 700;
  }
</style>
