---
// The 8 EIA benchmark regions as small multiples on one shared price scale.
// The y labels show on the first card of each row only; the cards beside it
// read across on the same scale and give that width to the plot.
import LineChart from "./LineChart.astro";
import NumbersTable from "./NumbersTable.astro";
import Change from "./Change.astro";
import Price from "./Price.astro";
import { buildChart, chartLabel, sharedDollarDomain, windowStart } from "../lib/chart.ts";
import { formatDate, when } from "../lib/dates.ts";
import { peakTag } from "../lib/doe.ts";
import { highLow, newest, peakKind, type Point } from "../lib/stats.ts";
import type { SiteData } from "../lib/site.ts";
interface Props {
  site: SiteData;
}
const { site } = Astro.props;
const HEIGHT = 132;
// One shared x window for all 8 panels and for the table under them. Anchoring
// each region on its own newest value ends that region a week early whenever its
// newest cell is blank, which drops the newest week from the shared table for
// every region and quietly breaks the shared scale the spec asks for.
const anchor = site.latest.eia?.period
  ?? site.regions.map((r) => newest(r.history)?.date ?? "").sort().pop()
  ?? "";
const since = anchor ? windowStart(anchor, 364) : "";
const inWindow = (pts: Point[]) => (anchor ? pts.filter((p) => p.date >= since && p.date <= anchor) : []);
const windows = site.regions.map((r) => ({ r, pts: inWindow(r.history) }));
// Round dollars that cover every region: $3.00 to $8.50 with $4, $6, $8 today.
const domain = sharedDollarDomain(windows.map((w) => w.pts));
const cards = windows.map(({ r, pts }) => {
  const last = newest(r.history);
  const hl = highLow(r.history);
  const model = anchor && pts.length
    ? buildChart([{ id: r.key, label: r.name, kind: "primary", points: r.history }], {
        from: since,
        to: anchor,
        yDomain: domain,
        heightPx: HEIGHT,
        xTicks: "sparse",
        wholeDollarTicks: true,
      })
    : null;
  const label = chartLabel({ name: `${r.name}, last 52 weeks`, points: pts, weekly: true });
  // The high row would repeat the headline price when this week is the high,
  // so it says so in words instead.
  const tag = peakTag(peakKind(r.history));
  const members = r.states.map((c) => site.byCode.get(c)).filter((s): s is NonNullable<typeof s> => Boolean(s));
  const states = members.filter((s) => s.code !== "DC").length;
  const count = members.length === 1 ? "" : ` ${states} states${states < members.length ? " and DC" : ""}:`;
  const covers = members.length ? `Covers${count} ${members.map((s) => s.name).join(", ")}.` : "";
  return { r, pts, model, hl, last, label, tag, members, covers };
});
const tableWeeks = [...new Set(windows.flatMap((w) => w.pts.map((p) => p.date)))].sort().reverse();
const firstDate = tableWeeks[tableWeeks.length - 1];
const lastDate = tableWeeks[0];
---
<div class="multiples">
  {cards.map((c) => (
    <article class="region" aria-labelledby={`region-${c.r.key}`}>
      <h3 id={`region-${c.r.key}`}>{c.r.name}</h3>
      {c.r.move ? (
        <p class="now">
          <Price price={c.r.move.price} class="now-price" />
          <Change change={c.r.move.change} pct={c.r.move.change_pct} cadence="weekly" showPct={false} signed />
        </p>
      ) : (
        <p class="now muted">No price this week</p>
      )}
      <p class="members small muted">
        {c.covers && <span class="sr-only">{c.covers}</span>}
        <span aria-hidden="true">{c.members.map((s) => s.code).sort().join(" ")}</span>
      </p>
      <div class="region-chart">
        {c.model && <LineChart model={c.model} height={HEIGHT} label={c.label} weekly compact />}
      </div>
      {c.hl && c.last && (
        <dl class="hl small">
          {c.tag ? (
            <div class="peak"><dt class="sr-only">52 week high</dt><dd>{c.tag}</dd></div>
          ) : (
            <div><dt>52 week high</dt><dd><Price price={c.hl.high.value} /> <span class="muted">{when(c.hl.high.date, c.last.date)}</span></dd></div>
          )}
          <div><dt>52 week low</dt><dd><Price price={c.hl.low.value} /> <span class="muted">{when(c.hl.low.date, c.last.date)}</span></dd></div>
        </dl>
      )}
    </article>
  ))}
</div>
<NumbersTable
  caption={`EIA weekly diesel price by region, ${firstDate ? formatDate(firstDate) : ""} to ${lastDate ? formatDate(lastDate) : ""}, newest first`}
  firstColumn="Week of"
  columns={site.regions.map((r) => r.name)}
  rows={tableWeeks.map((d) => ({ date: d, values: windows.map((w) => w.pts.find((p) => p.date === d)?.value ?? null) }))}
  label="Weekly region prices, scrolls sideways"
/>

<style is:global>
  .multiples {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
  }
  @media (max-width: 1023px) {
    .multiples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 559px) {
    .multiples {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Each card's name, price, states, chart and high/low sit on rows shared with
     the cards beside it, so the charts in a row line up on one scale even when a
     name or a state list wraps. */
  .region {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
    padding-top: var(--space-3);
    border-top: 2px solid var(--ink);
  }
  .region h3 {
    font-size: 17px;
    line-height: 1.25;
  }
  .region .now {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    margin: 2px 0 0;
  }
  .region .now-price {
    font-size: 24px;
    font-weight: 750;
  }
  .region .members {
    margin: 2px 0 10px;
    align-self: start;
  }
  /* y labels on the first card in each row only: 4 up, then 2 up, then 1 */
  @media (min-width: 1024px) {
    .region:not(:nth-child(4n + 1)) .chart-plot {
      --y-axis-w: 0px;
    }
    .region:not(:nth-child(4n + 1)) .y-axis {
      display: none;
    }
  }
  @media (min-width: 560px) and (max-width: 1023px) {
    .region:nth-child(even) .chart-plot {
      --y-axis-w: 0px;
    }
    .region:nth-child(even) .y-axis {
      display: none;
    }
  }
  .region .hl {
    margin: 8px 0 0;
    display: grid;
    gap: 2px;
    align-self: start;
  }
  .region .hl div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid var(--hairline);
    padding-top: 3px;
  }
  .region .hl dt {
    color: var(--ink-2);
  }
  .region .hl dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .region .hl .peak dd {
    font-weight: 650;
  }
</style>
