---
// Direction arrow from the road sign icons: rose, fell or about the same
// (src/lib/arrows.ts). It sits on the baseline at about the height of the
// digits beside it and wears the direction color; the numbers stay in ink.
// Always hidden from screen readers: the words next to it say the direction.
// `sprite` points at the page's ArrowSprite instead of inlining the path, for
// a spot that repeats down a long table or that a script shows and hides. That
// one is the same markup the page scripts build, kept short for 200 row tables.
import type { Direction } from "../lib/bins.ts";
import { arrowId, arrowPath } from "../lib/arrows.ts";
interface Props {
  direction: Direction;
  sprite?: boolean;
}
const { direction, sprite = false } = Astro.props;
---
{sprite ? (
  <svg class={`glyph glyph-${direction}`} aria-hidden="true"><use href={`#${arrowId(direction)}`}></use></svg>
) : (
  <svg class={`glyph glyph-${direction}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={arrowPath(direction)}></path></svg>
)}
