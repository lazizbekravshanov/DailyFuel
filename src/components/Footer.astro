---
import { formatBadgeDate, formatDate } from "../lib/dates.ts";
import { REPO_URL, type SiteData } from "../lib/site.ts";
interface Props {
  site: SiteData;
  /** On /about/ the page itself carries the full credits, so the footer drops its copy and its link back to the page. */
  compact?: boolean;
}
const { site, compact = false } = Astro.props;
const release = site.latest.eia?.release_date ?? site.weekly?.release_date ?? null;
const aaa = site.mode === "aaa+eia" ? site.latest.aaa : null;
const tax = site.tax;
---
<footer class="site-footer">
  <div class="wrap">
    {compact ? (
      <div class="about">
        <p>DailyFuel is free, with no ads, no cookies and no accounts.</p>
        <p>We count visits with Vercel Web Analytics. It uses no cookies and keeps nothing that could identify you, just totals like how many people came by today.</p>
        <p>Your last state is saved on this phone only.</p>
        <p><a href={REPO_URL}>Code on GitHub</a></p>
      </div>
    ) : (
      <>
        <h2 class="footer-title">Sources and credits</h2>
        <div class="cols">
          <div class="credits">
            {site.weekly && (
              <p>
                Weekly prices: U.S. Energy Information Administration, Gasoline and Diesel Fuel Update{release ? ` (released ${formatDate(release)})` : ""}.
              </p>
            )}
            {aaa && (
              <p>
                Daily state averages: AAA (<a href="https://gasprices.aaa.com/">gasprices.aaa.com</a>), data by OPIS. Price as of {formatBadgeDate(aaa.as_of)}. DailyFuel is not affiliated with AAA or OPIS.
              </p>
            )}
            {tax && (
              <p>
                Diesel tax: Federal Highway Administration, Highway Statistics table MF-121T ({tax.reporting_period} reporting period). U.S. government work, public domain.
              </p>
            )}
            <p class="muted">
              Map: us-atlas, from U.S. Census Bureau boundaries. Type: Overpass.{" "}
              <a href="/about/">Where the numbers come from</a>
            </p>
          </div>
          <div class="about">
            <p>DailyFuel is free, with no ads, no cookies and no accounts.</p>
            <p><a href={REPO_URL}>Code on GitHub</a></p>
          </div>
        </div>
      </>
    )}
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-7) var(--space-8);
    font-size: 15px;
    line-height: 1.5;
  }
  .footer-title {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-4);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-5) var(--space-7);
  }
  @media (max-width: 767px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  p {
    margin-bottom: var(--space-2);
  }
</style>
