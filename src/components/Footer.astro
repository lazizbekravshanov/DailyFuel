---
// The footer: where the numbers come from, that tax is in them, what the page
// keeps, and the ways on from the bottom of the page. Every date and name in it
// comes from the data, never typed by hand. The page itself already says how
// regions work and which states have no survey, so the footer doesn't repeat it.
import { formatBadgeDate, formatDate, todayInNewYork } from "../lib/dates.ts";
import { LATE_TEXT, nextEiaRelease, nextUpdateText } from "../lib/release.ts";
import { REPO_URL, type SiteData } from "../lib/site.ts";
interface Props {
  site: SiteData;
  /** On /about/ the page itself carries the full credits, so the footer drops its link to the page and says how visits are counted. */
  compact?: boolean;
}
const { site, compact = false } = Astro.props;
const eia = site.latest.eia ?? null;
const release = eia?.release_date ?? site.weekly?.release_date ?? null;
// The next EIA week, with EIA's own date and the holiday schedule behind it.
// Late at build time, or later in the browser (src/scripts/stale.js), it says so.
const next = eia
  ? nextEiaRelease(eia.period, eia.next_release_date ?? site.weekly?.next_release_date ?? null, todayInNewYork())
  : null;
const aaa = site.mode === "aaa+eia" ? site.latest.aaa : null;
const tax = site.tax;
---
<footer class="foot">
  <div class="wrap">
    <p>
      {site.weekly && (
        <>
          Prices: U.S. Energy Information Administration weekly survey{release ? `, released ${formatDate(release)}` : ""}.
          {next && (
            <>
              {" "}<span data-next-release={next.date} data-late={LATE_TEXT}>{next.late ? LATE_TEXT : nextUpdateText(next.date)}</span>
            </>
          )}
        </>
      )}
      {aaa && (
        <>
          {" "}Daily state averages: AAA (<a href="https://gasprices.aaa.com/">gasprices.aaa.com</a>), data by OPIS, as of {formatBadgeDate(aaa.as_of)}. DailyFuel is not affiliated with AAA or OPIS.
        </>
      )}
      {tax && <>{" "}Tax: Federal Highway Administration, {tax.reporting_period}.</>}
    </p>
    <p>Prices include federal and state tax.</p>
    <p>
      No ads, no cookies, no accounts. This phone keeps only the state you save, your day or night choice, and a copy of the pages you open, for when there is no signal.
      {compact && " Visits are counted with Vercel Web Analytics, which uses no cookies and keeps nothing that could identify you."}
    </p>
    <p class="flinks">
      <a href="/#states">All states</a> <span class="dot">·</span>{" "}
      <a href="/map/">Truck stop map</a> <span class="dot">·</span>{" "}
      {!compact && (
        <>
          <a href="/about/">Where the numbers come from</a> <span class="dot">·</span>{" "}
        </>
      )}
      <a href={REPO_URL}>Code on GitHub</a>
    </p>
  </div>
</footer>
