---
// Always visible legend: every bin with its direction arrow (rose, fell, or
// about the same for the middle bin), plus no data when it appears.
// The key never changes from week to week. Wide screens get a list with words;
// below 640px it folds into one horizontal strip with the bin edges under the
// joins, and the words stay for screen readers.
import Glyph from "./Glyph.astro";
import { legendItems, legendTicks, type Cadence } from "../lib/bins.ts";
interface Props {
  cadence: Cadence;
  noData?: string | null;
  title: string;
  /** One line computed from the data, like "All 8 regions rose, 21.2¢ to 49.1¢." */
  summary?: string | null;
}
const { cadence, noData = null, title, summary = null } = Astro.props;
const items = legendItems(cadence);
const ticks = legendTicks(cadence);
---
<div class="legend">
  <p class="legend-title" id="legend-title">{title}</p>
  {summary && <p class="legend-summary">{summary}</p>}
  <ul class="key" aria-labelledby="legend-title">
    {items.map((i) => (
      <li>
        <span class={`sw f-${i.key}`} aria-hidden="true"><Glyph direction={i.direction} /></span>
        <span class="label"><Glyph direction={i.direction} />{i.label}</span>
      </li>
    ))}
  </ul>
  <div class="ticks" aria-hidden="true">
    {ticks.map((t, n) => <span style={`grid-column:${n + 1}`}>{t}</span>)}
  </div>
  {noData && (
    <ul class="key key-nodata">
      <li>
        <span class="sw f-nodata" aria-hidden="true"></span>
        <span class="label"><span class="glyph" aria-hidden="true"></span>{noData}</span>
      </li>
    </ul>
  )}
</div>

<style>
  .legend-title {
    font-weight: 700;
    margin-bottom: var(--space-2);
  }
  .legend-summary {
    margin-bottom: var(--space-3);
    font-size: 15px;
    line-height: 1.35;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-size: 15px;
    /* a whole pixel line, centered in the 26px row, keeps the words on a
       whole pixel too, so the arrow and the letters round the same way */
    line-height: 20px;
  }
  .key-nodata {
    margin-top: 4px;
  }
  li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 26px;
  }
  .sw {
    flex: none;
    width: 28px;
    height: 18px;
    border-radius: 3px;
  }
  /* The arrow runs inline at the start of its label, like every other
     change on the site, so it stands on the words' baseline. A flex item
     would center on the line box and hang below the capitals. */
  .label :global(.glyph) {
    margin-right: 0.3em;
  }
  /* the copy of the glyph inside the swatch is only for the phone strip */
  .sw :global(.glyph) {
    display: none;
  }
  .ticks {
    display: none;
  }

  /* phones: one strip, 7 swatches with 2px paper joins */
  @media (max-width: 639px) {
    .key:not(.key-nodata) {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 2px;
      max-width: 420px;
    }
    .key:not(.key-nodata) li {
      flex-direction: column;
      align-items: stretch;
      gap: 5px;
      min-height: 0;
    }
    .key:not(.key-nodata) .sw {
      display: grid;
      place-items: center;
      width: auto;
      height: 20px;
      border-radius: 0;
    }
    /* on the strip the arrow sits on its swatch in the fill's own text color */
    .key:not(.key-nodata) .sw :global(.glyph) {
      display: block;
      width: 12px;
      height: 12px;
      margin: 0;
      fill: currentColor;
    }
    .key:not(.key-nodata) li:first-child .sw {
      border-radius: 3px 0 0 3px;
    }
    .key:not(.key-nodata) li:last-child .sw {
      border-radius: 0 3px 3px 0;
    }
    .key:not(.key-nodata) .label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .ticks {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 2px;
      max-width: 420px;
      margin-top: 2px;
      font-size: 12px;
      line-height: 1.2;
      color: var(--ink-2);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    /* each edge label centers on the join to the right of its column */
    .ticks span {
      justify-self: end;
      transform: translateX(calc(50% + 1px));
    }
    .key-nodata {
      margin-top: var(--space-3);
    }
    .key-nodata .glyph {
      display: none;
    }
  }
</style>
