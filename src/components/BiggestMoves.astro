---
// Moves beside the map. Regions in eia_only: one list of all 8, biggest rise
// first, each with its member states in muted text. States in aaa+eia: the top
// rises and drops, and a group with nothing in it is left out.
import Change from "./Change.astro";
import Price from "./Price.astro";
import type { Cadence } from "../lib/bins.ts";
import { changeTenths } from "../lib/format.ts";
import { byChange } from "./home/home.ts";
export interface MoveItem {
  name: string;
  href?: string;
  price: number;
  change: number;
  pct: number | null;
  /** Member states for a region, shown as codes after its name. */
  members?: { code: string; name: string }[];
}
interface Props {
  items: MoveItem[];
  cadence: Cadence;
  noun: string;
  /** "list" shows every item in one list, "split" shows top rises and drops. */
  layout?: "list" | "split";
  count?: number;
  title?: string;
  /** Said when there is nothing to list at all. */
  empty?: string;
}
const { items, cadence, noun, layout = "split", count = 3, title = "Change by region", empty = `No ${noun} has a change yet.` } = Astro.props;
const rises = items.filter((i) => changeTenths(i.change) > 0).sort((a, b) => b.change - a.change).slice(0, count);
const falls = items.filter((i) => changeTenths(i.change) < 0).sort((a, b) => a.change - b.change).slice(0, count);
const groups = layout === "list"
  ? [{ title, list: byChange(items) }]
  : [
      { title: "Biggest rises", list: rises },
      { title: "Biggest drops", list: falls },
    ].filter((g) => g.list.length > 0);
---
<div class="moves">
  {groups.length === 0 || groups.every((g) => g.list.length === 0) ? (
    <p class="muted">{empty}</p>
  ) : groups.map((g) => (
    <div class="group">
      <h3>{g.title}</h3>
      <ol>
        {g.list.map((i) => (
          <li>
            <span class="who">
              {i.href ? <a href={i.href}>{i.name}</a> : i.name}
              {i.members && i.members.length > 1 && (
                <>
                  <span class="codes" aria-hidden="true">{i.members.map((m) => m.code).join(" ")}</span>
                  <span class="sr-only">, {i.members.map((m) => m.name).join(", ")}</span>
                </>
              )}
            </span>
            <Change change={i.change} pct={i.pct} cadence={cadence} showPct={false} />
            <span class="at muted"><Price price={i.price} /></span>
          </li>
        ))}
      </ol>
    </div>
  ))}
</div>

<style>
  .moves {
    display: grid;
    gap: var(--space-5);
  }
  h3 {
    font-size: 17px;
    margin-bottom: var(--space-2);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: 4px 14px;
    padding: 7px 0 5px;
    border-top: 1px solid var(--hairline);
    font-variant-numeric: tabular-nums;
  }
  li:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .who {
    position: relative;
    min-width: 0;
    line-height: 1.35;
  }
  .codes {
    display: block;
    color: var(--ink-2);
    font-size: 13px;
    letter-spacing: 0.02em;
    word-spacing: 0.1em;
  }
  .at {
    min-width: 4.2em;
    text-align: right;
  }
  p {
    margin: 0;
  }
</style>
