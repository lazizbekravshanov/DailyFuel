---
// A price change: the direction arrow in color, the numbers in ink.
// "31.8¢ (+5.3%)". With a cadence the arrow follows the map bins, so a change
// under the about the same line gets the about the same arrow. Where no signed
// percent follows, `signed` puts the sign on the cents ("+49.1¢"), so copied
// text still says which way it moved, since the arrow never copies.
// `narrowSign` is for a spot whose percent steps out on a phone: the sign
// sits in its own span (.narrow-sign) that the page's CSS shows only there.
import Glyph from "./Glyph.astro";
import { directionFor, type Cadence, type Direction } from "../lib/bins.ts";
import { centsSign, changeTenths, formatChange, formatPct, formatSignedCents, pctFrom, spokenChange } from "../lib/format.ts";
interface Props {
  change: number | null;
  pct?: number | null;
  prev?: number | null;
  cadence?: Cadence | null;
  showPct?: boolean;
  /** Sign the cents when no percent is shown. */
  signed?: boolean;
  /** Put the sign in a .narrow-sign span that the page shows only where it hides the percent. */
  narrowSign?: boolean;
  /** Point the arrow at the page's ArrowSprite, for rows that repeat. */
  sprite?: boolean;
  empty?: string;
  class?: string;
}
const {
  change,
  pct = null,
  prev = null,
  cadence = null,
  showPct = true,
  signed = false,
  narrowSign = false,
  sprite = false,
  empty = "No change yet",
  class: cls,
} = Astro.props;
let direction: Direction = "flat";
let text = "";
let lead = "";
let spoken = "";
if (change !== null) {
  const t = changeTenths(change);
  direction = cadence ? directionFor(change, cadence) : t > 0 ? "up" : t < 0 ? "down" : "flat";
  // the raw numbers first, so the percent is rounded once (see pctOf in copy.ts)
  const p = prev ? pctFrom(change, prev) : pct;
  const shownPct = showPct ? p : null;
  const signedCents = signed && shownPct === null;
  text = signedCents ? formatSignedCents(change) : formatChange(change, shownPct);
  if (narrowSign && !signedCents) lead = centsSign(change);
  const pctSpoken = showPct && p !== null ? `, ${formatPct(p).replace("−", "minus ").replace("+", "plus ")}` : "";
  spoken = `${direction === "flat" && t !== 0 ? "about the same, " : ""}${spokenChange(change)}${pctSpoken}`;
}
---
{change === null ? (
  <span class:list={["change", "muted", cls]}>{empty}</span>
) : (
  <span class:list={["change", cls]} data-dir={direction}><Glyph direction={direction} sprite={sprite} /><span class="sr-only">{spoken}</span><span aria-hidden="true">{lead && <span class="narrow-sign">{lead}</span>}{text}</span></span>
)}
