---
// The REGIONS board: EIA's weekly number for the U.S. and its 8 regions, with
// the 52 week range, a sparkline and who each price covers, and the notes
// beside it. Every word comes from the data.
import Spark from "./Spark.astro";
import { biggestNote, coverage, keyLine, memberCount, recordNote, sharedNote } from "./home.ts";
import type { Spark as SparkLine } from "./chart.ts";
import { moveClass } from "../../lib/bins.ts";
import { pctOf } from "../../lib/copy.ts";
import { formatDate, formatShortDate } from "../../lib/dates.ts";
import { formatQuote, signedCents, signedPct } from "../../lib/format.ts";
import { type SiteData } from "../../lib/site.ts";
import { peakKind } from "../../lib/stats.ts";
import type { Move } from "../../lib/data.ts";
interface Props {
  site: SiteData;
  /** The 52 week lines, by series key, drawn once into the page's sprite. */
  sparks: Map<string, SparkLine>;
}
const { site, sparks } = Astro.props;
const eia = site.latest.eia;
const daily = site.mode === "aaa+eia";

interface Row {
  key: string;
  name: string;
  move: Move | null;
  covers: string;
  /** the region's states, A to Z by code, for the phone's line of links under it */
  codes?: string[];
  us?: boolean;
}
// California last, after the rest of the West Coast, the way the board reads
const order = ["R1X", "R1Y", "R1Z", "R20", "R30", "R40", "R5XCA", "SCA"];
const regions = order.map((k) => site.regions.find((r) => r.key === k)).filter((r): r is NonNullable<typeof r> => Boolean(r));
const surveyed = site.states.filter((s) => s.eia_series !== null).map((s) => s.code);
const rows: Row[] = [
  { key: "NUS", name: "U.S.", move: site.eiaUs, covers: coverage(surveyed), us: true },
  ...regions.map((r) => ({ key: r.key, name: r.name, move: r.move, covers: memberCount(r.states), codes: [...r.states].sort() })),
];

// The line beside the head and the notes beside the board.
const moved = regions.filter((r) => r.move && r.move.change !== null).map((r) => ({ name: r.name, change: r.move!.change! }));
const key = keyLine(moved, "region", "weekly");
const biggest = biggestNote(moved, "weekly");
const largest = regions.reduce((a, b) => (b.states.length > a.states.length ? b : a), regions[0]);
const shared = largest && largest.move ? sharedNote({ name: largest.name, codes: largest.states, price: largest.move.price }, daily) : null;
const unsurveyed = site.states.filter((s) => s.eia_series === null);
// which regions are at their highest, by name: "Rocky Mountain is at its highest price in our records, which start June 2022."
const record = recordNote(regions.map((r) => ({ name: r.name, kind: peakKind(r.history) })));
const period = eia ? formatDate(eia.period) : null;
const prev = eia?.prev_period ? formatShortDate(eia.prev_period) : null;
---
<section class="board" aria-labelledby="regions-title">
  <div class="sh"><h2 id="regions-title">Prices by region</h2>{key && <p class="meta">{key}</p>}</div>
  <div class="cols">
    <div>
      <div class="scroll" tabindex="0" role="region" aria-label="Regions table, scrolls sideways">
        <table aria-describedby="board-cap" style="min-width:calc(81ch + 222px)">
          {/* Widths settled before a row arrives, as on the quote table, and
              the table's floor is their sum, so nothing moves as the board
              streams in. */}
          <colgroup>
            <col style="width:calc(29ch + 10px)" />
            <col style="width:calc(7ch + 20px)" />
            <col style="width:calc(7ch + 20px)" />
            <col style="width:calc(7ch + 20px)" />
            <col style="width:calc(7ch + 20px)" />
            <col style="width:calc(8ch + 20px)" />
            <col style="width:92px" />
            <col style="width:calc(16ch + 20px)" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">Region</th>
              <th scope="col" class="num" aria-label="Price, dollars a gallon">Price $</th>
              <th scope="col" class="num" aria-label="Change in cents from last week">Change ¢</th>
              <th scope="col" class="num" aria-label="Change in percent from last week">Change %</th>
              <th scope="col" class="num" aria-label="Lowest price in the past year">Year low</th>
              <th scope="col" class="num" aria-label="Highest price in the past year">Year high</th>
              <th scope="col" aria-label="Line of the past year">Past year</th>
              <th scope="col">States</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => {
              const s = sparks.get(r.key);
              const m = r.move;
              const pct = m ? pctOf(m) : null;
              const ink = m ? moveClass(m.change, "weekly") : "muted";
              return (
                <>
                <tr class:list={[r.us && "us", r.codes && "hm"]}>
                  <th scope="row">{r.name}</th>
                  {m ? (
                    <>
                      <td class="num">{formatQuote(m.price)}</td>
                      <td class:list={["num", ink]}>{m.change === null ? "n/a" : signedCents(m.change)}</td>
                      <td class:list={["num", ink]}>{pct === null ? "n/a" : signedPct(pct)}</td>
                    </>
                  ) : (
                    <td class="muted" colspan="3">No price this week</td>
                  )}
                  {s ? (
                    <>
                      <td class="num">{formatQuote(s.low.value)}</td>
                      <td class="num">{formatQuote(s.high.value)}</td>
                      <td><Spark id={r.key} name={r.name} spark={s} /></td>
                    </>
                  ) : (
                    <>
                      <td class="num muted">n/a</td>
                      <td class="num muted">n/a</td>
                      <td></td>
                    </>
                  )}
                  <td class="muted">{r.covers}</td>
                </tr>
                {/* on a phone, the region's states as links on their own line under it */}
                {r.codes && (
                  <tr class="mr"><td colspan="8" class="mem">{r.codes.map((c) => <><a href={`/state/${c.toLowerCase()}/`}>{c}</a>{" "}</>)}</td></tr>
                )}
                </>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="cap swipe">Swipe the table left for the past year and the states each region covers.</p>
      <p class="cap" id="board-cap">
        Every state in a region shows the same weekly price, and California is priced on its own.
        {period && ` Prices are dollars a gallon for the week of ${period}.`}{period && prev && ` Change is in cents from the week of ${prev}.`}
      </p>
    </div>
    <div class="notes">
      {shared && <p><b>One price, many states.</b> {shared}</p>}
      {biggest && <p><b>{biggest.head}</b> {biggest.text}</p>}
      {record && <p><b>Record high.</b> {record}</p>}
      {unsurveyed.length > 0 && (
        <p class="ns"><b>No weekly survey.</b> {unsurveyed.map((u, i) => <>{i > 0 && (i === unsurveyed.length - 1 ? " and " : ", ")}<a href={u.href}>{u.name}</a></>)} {unsurveyed.length === 1 ? "has" : "have"} no weekly price.</p>
      )}
    </div>
  </div>
</section>

<style is:global>
  /* the board is about 850px wide beside its 290px of notes, so it scrolls
     sideways under 1200px, and on its own under 900px */
  @media (max-width: 1199px) {
    .board .swipe {
      display: block;
    }
  }
</style>
