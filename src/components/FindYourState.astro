---
// "Find your state": every state in one list, inside a plain <details>, so it
// opens and closes with JS off. On the home page it sits under the your state
// strip: closed until asked for, hidden once a state is saved, and back when
// CHANGE is pressed. The 404 page shows it open. A tap on a state saves it for
// the home page (src/scripts/your-state.ts), then the link goes to its page.
// With JS off the link still works; nothing is saved.
//
// On the home page each link also carries that state's line for the strip
// (price, change, ink, plate), printed at build time, so the script that
// fills the strip only copies strings. That script (YourState.astro) also
// saves a pick, so the home page skips the pick script here.
//
// The /#find-your-state target is the list inside the <details>, not the
// <details> itself, so Chrome opens the closed list when a link lands on it,
// even with JS off.
import { getSite } from "../lib/site.ts";
import { inlineCall } from "../lib/inline.ts";
import { yourStateData } from "../lib/yourstate.ts";
import { rememberPick } from "../scripts/your-state.ts";
interface Props {
  open?: boolean;
  /** Carry each state's strip line on its link (the home page). */
  strip?: boolean;
}
const { open = false, strip = false } = Astro.props;
const site = getSite();
const lines = strip ? new Map(yourStateData(site).map((e) => [e.code, e])) : null;
const states = [...site.states].sort((a, b) => a.name.localeCompare(b.name));
const pick = inlineCall(rememberPick, "document", "function(){return window.localStorage}");
---
<details class="pick" data-ys-find open={open}>
  <summary class="btn">Find your state</summary>
  <ul class="pick-list" id="find-your-state" data-ys-list tabindex="-1" aria-label="All states">
    {states.map((s) => {
      const l = lines?.get(s.code);
      return (
        <li><a href={s.href} data-ys-pick={s.code} data-px={l?.price} data-ch={l?.move || undefined} data-ink={l && l.ink !== "muted" ? l.ink : undefined} data-pl={l?.plate ?? undefined}><b>{s.code}</b> {s.name}</a></li>
      );
    })}
  </ul>
</details>
{!strip && <script is:inline set:html={pick}></script>}

<style is:global>
  .pick {
    margin-top: 10px;
  }
  /* the summary is the control, drawn like every other small control */
  .pick > summary {
    list-style: none;
  }
  .pick > summary::-webkit-details-marker {
    display: none;
  }
  .pick-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0 24px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-t);
    /* where /#find-your-state lands: the summary stays in view above the list */
    scroll-margin-top: 48px;
  }
  .pick-list:focus-visible {
    outline-offset: 4px;
  }
  .pick-list li {
    min-width: 0;
    border-bottom: 1px solid var(--hair);
  }
  .pick-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 26px;
    padding: 2px 0;
    text-decoration: none;
  }
  .pick-list a:hover {
    background: var(--mark);
  }
  .pick-list b {
    flex: none;
    width: 2.5ch;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
