---
// The table twin under a chart: every value the chart draws, as text, newest
// first, under a "Show the numbers" summary. Prices print as 6.285 under a
// head that says LAST $. It is also where the chart's readout script reads
// its dates and prices (src/scripts/chart.js), so the page carries each
// value once: the price cells wear the `v` class for it. No sort buttons and
// no change column: the paper terminal prints the sheet as it is, and the
// readout says each week's move.
import { formatDate } from "../lib/dates.ts";
import { formatQuote } from "../lib/format.ts";
interface Props {
  /** What the table holds, for screen readers: "Midwest weekly diesel price since June 2022, newest first". */
  caption: string;
  /** "Week of" or "Date". */
  firstColumn: string;
  /** One head per price column: "Last $", or "AAA daily $" and "EIA Midwest $". */
  columns: string[];
  /** Newest first. */
  rows: { date: string; values: (number | null)[] }[];
  /** Names the scrolling box for keyboard users. */
  label: string;
}
const { caption, firstColumn, columns, rows, label } = Astro.props;
---
<details class="numbers">
  <summary class="btn">Show the numbers</summary>
  <div class="scroll" tabindex="0" role="region" aria-label={label}>
    <table>
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <th scope="col">{firstColumn}</th>
          {columns.map((c) => <th scope="col" class="num v">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>{formatDate(row.date)}</td>
            {row.values.map((v) => <td class:list={["num", "v", v === null && "muted"]}>{v === null ? "n/a" : formatQuote(v)}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</details>

<style is:global>
  .numbers {
    margin-top: 12px;
  }
  /* the summary is the control, drawn like Find your state's: no disclosure
     triangle, since the design has no arrows */
  .numbers > summary {
    list-style: none;
  }
  .numbers > summary::-webkit-details-marker {
    display: none;
  }
  /* two hundred weeks stay shorter than the screen, and scroll inside their box */
  .numbers .scroll {
    max-height: 60vh;
    max-width: 420px;
    margin-top: 8px;
    overflow-y: auto;
  }
  .numbers thead th {
    position: sticky;
    top: 0;
    background: var(--bg);
  }
</style>
