---
// The table twin under a chart: every value the chart draws, as text.
// Plain three decimal prices here, since this table is for reading and copying numbers.
// With one or two price columns it also gets a Change column for the first one
// (vs the next older row), and its headers sort (src/scripts/twin-sort.js).
// The markup stays lean on purpose: a state table has over 200 rows.
import sortScript from "../scripts/twin-sort.js?raw";
import { directionFor, type Cadence } from "../lib/bins.ts";
import { formatDate } from "../lib/dates.ts";
import { changeTenths, formatCents, formatPrice, spokenChange, toUnits } from "../lib/format.ts";
interface Props {
  caption: string;
  firstColumn: string;
  columns: string[];
  /** Newest first. */
  rows: { date: string; values: (number | null)[] }[];
  label: string;
  tall?: boolean;
  /** Add a Change column after the first price column. Defaults to on for one or two price columns. */
  change?: boolean;
  /** Which bins the change glyph follows. Defaults to weekly when the first column is "Week of". */
  cadence?: Cadence;
}
const { caption, firstColumn, columns, rows, label, tall = false } = Astro.props;
const withChange = Astro.props.change ?? (columns.length > 0 && columns.length <= 2);
const cadence: Cadence = Astro.props.cadence ?? (firstColumn === "Week of" ? "weekly" : "daily");
const noneYet = cadence === "weekly" ? "First week" : "First day";

// Each row's move from the next older row that has a price. Rows are newest first.
const changes = rows.map((row, i) => {
  const v = row.values[0];
  if (!withChange || v === null) return null;
  const older = rows.slice(i + 1).find((o) => o.values[0] !== null);
  if (!older) return null;
  const change = (toUnits(v) - toUnits(older.values[0]!)) / 10000;
  const dir = directionFor(change, cadence);
  // the same words the Change component speaks, without its per row SVG
  const spoken = `${dir === "flat" && changeTenths(change) !== 0 ? "about the same, " : ""}${spokenChange(change)}`;
  return { change, dir, spoken, text: formatCents(change) };
});
---
<details class="numbers">
  <summary>Show the numbers</summary>
  <div class:list={["table-scroll", tall && "table-tall"]} tabindex="0" role="region" aria-label={label}>
    <table class="data" data-twin-sort={withChange ? "" : undefined}>
      <caption>{caption}</caption>
      <thead>
        <tr>
          <th scope="col" data-sort-type={withChange ? "date" : undefined} aria-sort={withChange ? "descending" : undefined}>{firstColumn}</th>
          {columns.map((c, i) => (
            <>
              <th scope="col" class="r" data-sort-type={withChange ? "number" : undefined}>{c}</th>
              {withChange && i === 0 && <th scope="col" class="chg" data-sort-type="number">Change</th>}
            </>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, r) => (
          <tr>
            <th scope="row">{formatDate(row.date)}</th>
            {row.values.map((v, i) => (
              <>
                <td class="r">{v === null ? "No price" : formatPrice(v)}</td>
                {withChange && i === 0 && (changes[r] ? (
                  <td class="chg" data-sort={changes[r]!.change}><span class={`tg tg-${changes[r]!.dir}`}></span><span class="sr-only">{changes[r]!.spoken}</span><span aria-hidden="true">{changes[r]!.text}</span></td>
                ) : (
                  <td class="chg muted" data-sort="">{v === null ? "No price" : noneYet}</td>
                ))}
              </>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {withChange && <p class="sr-only twin-status" aria-live="polite"></p>}
  {withChange && <script is:inline set:html={sortScript}></script>}
</details>

<style is:global>
  /* never taller than most of the screen, so the page can still scroll past it */
  .numbers .table-tall {
    max-height: min(440px, 70vh);
  }
  .numbers .chg {
    padding-left: var(--space-4);
  }
  .numbers th[data-sort-type] {
    padding-top: 0;
    padding-bottom: 0;
    vertical-align: bottom;
  }
  /* direction glyphs drawn in CSS, the same shapes as Glyph.astro, so a 200
     row table doesn't carry 200 inline SVGs */
  .numbers .tg {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.3em;
    vertical-align: 0.02em;
  }
  .numbers .tg-up {
    background: var(--glyph-up);
    clip-path: polygon(50% 8%, 98% 92%, 2% 92%);
  }
  .numbers .tg-down {
    background: var(--glyph-down);
    clip-path: polygon(2% 8%, 98% 8%, 50% 92%);
  }
  .numbers .tg-flat {
    background: var(--glyph-flat);
    clip-path: circle(36%);
  }
  .numbers .sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 4px 0 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .numbers th.r .sort-btn {
    flex-direction: row-reverse;
  }
  .numbers .sort-icon {
    width: 8px;
    height: 12px;
    fill: var(--hairline-strong);
  }
  .numbers th[aria-sort="ascending"] .sort-up,
  .numbers th[aria-sort="descending"] .sort-down {
    fill: var(--ink);
  }
  @media (forced-colors: active) {
    .numbers .tg {
      forced-color-adjust: none;
      background: CanvasText;
    }
    .numbers .sort-icon {
      fill: GrayText;
    }
    .numbers th[aria-sort="ascending"] .sort-up,
    .numbers th[aria-sort="descending"] .sort-down {
      fill: CanvasText;
    }
  }
</style>
