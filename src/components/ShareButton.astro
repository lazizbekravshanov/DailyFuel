---
// The SHARE control in the header: the phone's share sheet, or the link on
// the clipboard. Rendered hidden. The inline script right after it
// (src/scripts/share.ts) shows it only when the browser can share or copy, so
// with JS off there's no button that does nothing. The status before it says
// "Link copied", or shows the link when copying fails too. No tracking,
// nothing sent anywhere.
import { SITE_URL } from "../lib/site.ts";
import { inlineCall } from "../lib/inline.ts";
import { shareButton } from "../scripts/share.ts";
interface Props {
  /** One plain sentence with the page's numbers, built at build time. */
  text: string;
  class?: string;
}
const { text, class: cls } = Astro.props;
// The same canonical URL Base.astro puts in <link rel="canonical">.
const url = new URL(Astro.url.pathname, Astro.site?.href ?? SITE_URL).href;
const script = inlineCall(shareButton, "document", "navigator");
---
<div class:list={["share", cls]} data-share hidden>
  {/* always in the page, even empty, so screen readers hear it change */}
  <span class="tag share-status" data-share-status role="status"></span>
  <button type="button" class="btn" data-text={text} data-url={url}>Share</button>
</div>
<script is:inline set:html={script}></script>
