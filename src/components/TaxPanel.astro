---
// What tax is on a gallon of diesel in one state: four boxes in the hairline
// grid the key stats use, then the scope note. Tax is a separate fact from the
// prices DailyFuel measures, so it never wears the change colours. DC reads
// "Not listed" (FHWA prints no rate), and Utah and Minnesota read "Out of
// date" (FHWA still prints a rate the state has since replaced), with no
// total and no rank for any of the three.
import { formatCpg, rankLabel, sinceLabel, taxVintage } from "../lib/tax.ts";
import type { SiteData, StateView } from "../lib/site.ts";

interface Props {
  site: SiteData;
  state: StateView;
  /** True when a pump price sits above the panel, so the note can say the tax is inside it. */
  priced?: boolean;
}
const { site, state: s, priced = false } = Astro.props;
const tax = site.tax!;
const v = s.tax!;
const rank = rankLabel(v);
const since = sinceLabel(v);
// "District of Columbia tax" wraps on a phone, and DC is what people call it.
const stateLabel = `${s.code === "DC" ? "DC" : s.name} tax`;
---
<section aria-labelledby="tax-title">
  <div class="sh"><h2 id="tax-title">Tax</h2><p class="meta">FHWA table MF-121T, {tax.reporting_period}</p></div>
  <dl class="stats">
    <div>
      <dt>{stateLabel}</dt>
      {v.outOfDate ? (
        <>
          <dd class="w">Out of date</dd>
          <dd class="s">FHWA's rate is old</dd>
        </>
      ) : v.state !== null ? (
        <>
          <dd>{formatCpg(v.state)}</dd>
          <dd class="s">{since ?? "A gallon"}</dd>
        </>
      ) : (
        <>
          <dd class="w">Not listed</dd>
          <dd class="s">FHWA's table has no rate</dd>
        </>
      )}
    </div>
    <div>
      <dt>Federal tax</dt>
      <dd>{formatCpg(v.federal)}</dd>
      <dd class="s">Same everywhere</dd>
    </div>
    <div>
      <dt>Total tax</dt>
      {v.total !== null ? (
        <>
          <dd>{formatCpg(v.total)}</dd>
          <dd class="s">State plus federal</dd>
        </>
      ) : (
        <>
          <dd class="w">n/a</dd>
          <dd class="s">Needs a state rate</dd>
        </>
      )}
    </div>
    <div>
      <dt>Rank</dt>
      {rank ? (
        <>
          <dd>{rank}</dd>
          <dd class="s">of {v.ranked} with a current rate</dd>
        </>
      ) : (
        <>
          <dd class="w">Not ranked</dd>
          <dd class="s">No current rate</dd>
        </>
      )}
    </div>
  </dl>
  {v.note && <p class="fine note">{v.note}</p>}
  <p class="fine note">{tax.scope} {taxVintage(tax)}{priced && " Tax is already inside the pump price above."}</p>
</section>
