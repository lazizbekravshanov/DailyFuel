---
// What tax is on a gallon of diesel in one state: the one fact a driver needs
// first, in full ink (tax is already in the price), then four boxes in the
// hairline grid the stats use, then the fine print folded under one button,
// with whatever the page adds to it (the DOE line, the AAA link). Tax is a
// separate fact from the prices DailyFuel measures, so it never wears the
// change colours. DC reads "Not listed" (FHWA prints no rate), and Utah and
// Minnesota read "Out of date" (FHWA still prints a rate the state has since
// replaced), with no total and no rank for any of the three.
import { formatCpg, rankLabel, sinceLabel, taxVintage } from "../lib/tax.ts";
import type { SiteData, StateView } from "../lib/site.ts";

interface Props {
  site: SiteData;
  state: StateView;
  /** True when a pump price sits above the panel, so the note can say the tax is inside it. */
  priced?: boolean;
}
const { site, state: s, priced = false } = Astro.props;
const tax = site.tax!;
const v = s.tax!;
const rank = rankLabel(v);
const since = sinceLabel(v);
// "District of Columbia tax" wraps on a phone, and DC is what people call it.
const stateLabel = `${s.code === "DC" ? "DC" : s.name} tax`;
---
<section aria-labelledby="tax-title">
  <div class="sh"><h2 id="tax-title">Tax</h2><p class="meta">Cents a gallon, {tax.reporting_period} federal table</p></div>
  {priced && <p class="note tin">Tax is already in the pump price above.</p>}
  <dl class="stats">
    <div>
      <dt>{stateLabel}</dt>
      {v.outOfDate ? (
        <>
          <dd class="w">Out of date</dd>
          <dd class="s">Our source is out of date</dd>
        </>
      ) : v.state !== null ? (
        <>
          <dd>{formatCpg(v.state)}</dd>
          <dd class="s">{since ?? "A gallon"}</dd>
        </>
      ) : (
        <>
          <dd class="w">Not listed</dd>
          <dd class="s">Not in our source</dd>
        </>
      )}
    </div>
    <div>
      <dt>Federal tax</dt>
      <dd>{formatCpg(v.federal)}</dd>
      <dd class="s">Same in every state</dd>
    </div>
    <div>
      <dt>Total tax</dt>
      {v.total !== null ? (
        <>
          <dd>{formatCpg(v.total)}</dd>
          <dd class="s">State plus federal</dd>
        </>
      ) : (
        <>
          <dd class="w">Unknown</dd>
          <dd class="s">State rate unknown</dd>
        </>
      )}
    </div>
    <div>
      <dt>Rank</dt>
      {rank ? (
        <>
          <dd>{rank}</dd>
          <dd class="s">Out of {v.ranked} states ranked</dd>
        </>
      ) : (
        <>
          <dd class="w">Not ranked</dd>
          <dd class="s">No current rate</dd>
        </>
      )}
    </div>
  </dl>
  <details class="more">
    <summary class="btn wide">What the price and tax include</summary>
    {v.note && <p class="fine note">{v.note}</p>}
    <p class="fine note">{tax.scope} {taxVintage(tax)}</p>
    <slot />
  </details>
</section>
