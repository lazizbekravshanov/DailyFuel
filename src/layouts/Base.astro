---
import "../styles/tokens.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import ShareButton from "../components/ShareButton.astro";
import StaleBanner from "../components/StaleBanner.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { formatShortDate, todayInNewYork } from "../lib/dates.ts";
import { inlineCall } from "../lib/inline.ts";
import { CARD_HEIGHT, CARD_WIDTH, cardMeta } from "../lib/og.ts";
import { formatShortWeekdayDate, nextEiaRelease } from "../lib/release.ts";
import { getSite, SITE_NAME, SITE_URL } from "../lib/site.ts";
import { applyStoredTheme } from "../scripts/theme.ts";
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** The skip link names what it skips to. Pages with no prices say "Skip to main content". */
  skipLabel?: string;
  /** One plain sentence with the page's numbers. When given, the header shows the Share control. */
  share?: string;
}
const { title, description, noindex = false, skipLabel = "Skip to the numbers", share } = Astro.props;
const site = getSite();
const origin = Astro.site?.href ?? SITE_URL;
const canonical = new URL(Astro.url.pathname, origin).href;
const current = Astro.url.pathname;
// The share card for this page, worked out from the path and the newest data,
// so page files don't have to pass anything in.
const card = cardMeta(site, current, origin);
// Tells search engines the site's name, so results say DailyFuel and not the vercel.app host.
const website = current === "/"
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE_NAME,
      alternateName: "DailyFuel diesel prices",
      url: new URL("/", origin).href,
      inLanguage: "en-US",
    }).replace(/</g, "\\u003c")
  : null;
// Visit counts: Vercel Web Analytics, first party, no cookies. Only in Vercel
// production builds, so preview deploys and local builds never load it. The
// script records the page view by itself; the site never calls va(), so the
// queue stub Vercel's snippet starts with is left out (it cost the home page
// its inline script budget).
const analytics = process.env.VERCEL_ENV === "production";
// A saved light or dark choice goes on <html> before the first paint.
const themeBoot = inlineCall(applyStoredTheme, "document", "function(){return window.localStorage}");

// The header's meta line: which week the numbers are for and when the next
// ones land. EIA's own next release date, checked against the holiday
// schedule, and the stale script turns it into a late notice in the browser
// once that day has passed.
const aaa = site.mode === "aaa+eia" ? site.latest.aaa : null;
const eia = site.latest.eia ?? null;
const next = eia
  ? nextEiaRelease(eia.period, eia.next_release_date ?? site.weekly?.next_release_date ?? null, todayInNewYork())
  : null;
const LATE = "next update is late";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={themeBoot}></script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={card.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(CARD_WIDTH)} />
    <meta property="og:image:height" content={String(CARD_HEIGHT)} />
    <meta property="og:image:alt" content={card.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={card.alt} />
    {website && <script type="application/ld+json" set:html={website} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{skipLabel}</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-current={current === "/" ? "page" : undefined}>DailyFuel</a>
        <span class="tag tl">U.S. on-highway diesel <span class="dot">·</span> {aaa ? "AAA daily, EIA weekly" : "EIA weekly"}</span>
        <div class="right">
          {aaa ? (
            <span class="tag wk">
              As of {formatShortDate(aaa.as_of)}
              {eia && <> <span class="dot">·</span> EIA week of {formatShortDate(eia.period)}</>}
            </span>
          ) : eia ? (
            <span class="tag wk">
              Week of {formatShortDate(eia.period)}
              {next && (
                <> <span class="dot">·</span> <span data-next-release={next.date} data-late={LATE}>{next.late ? LATE : `next ${formatShortWeekdayDate(next.date)}`}</span></>
              )}
            </span>
          ) : null}
          <a class="btn" href="/map/" aria-current={current.startsWith("/map") ? "page" : undefined}>Map</a>
          {share && <ShareButton text={share} />}
          <ThemeToggle />
        </div>
      </div>
    </header>
    <StaleBanner site={site} />
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} compact={current.startsWith("/about")} />
    <slot name="scripts" />
    {analytics && <script is:inline defer src="/_vercel/insights/script.js"></script>}
  </body>
</html>
